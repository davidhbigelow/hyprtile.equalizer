    acquire_watcher_lock,
    clear_snapshot,
    clear_workspace_ids,
    get_config_choice,
    load_workspace_ids,
    proc_start_time,
    read_pid_record,
    remove_pid_record,
    write_pid_record,
)

SOCKET = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"),
    "hypr",
    os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
    ".socket2.sock",
)
IPC_SOCKET = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"),
    "hypr",
    os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
    ".socket.sock",
)
SCRIPT_PATH = os.path.realpath(__file__)
HYPRCTL = "/usr/bin/hyprctl"


def load_wanted():
    """Set of workspace ids currently marked equalized."""
    return load_workspace_ids()


def reset_state():
    """Start each session fresh: no desktop is equalized until SUPER+E is pressed."""
    try:
        clear_workspace_ids()
    except OSError:
        pass

HYPRCTL_TIMEOUT = float(os.environ.get("EQUALIZE_HYPRCTL_TIMEOUT", "1.5"))
HYPRCTL_MAX_OUTPUT = int(
    os.environ.get("EQUALIZE_HYPRCTL_MAX_OUTPUT", str(512 * 1024))
)
ADDRESS_RE = re.compile(r"^0x[0-9a-fA-F]+$")
LOCK_FD = None


def normalize_address(value):
    if isinstance(value, str):
        token = value.strip()
        if ADDRESS_RE.fullmatch(token):
            return token.lower()
    return None


def hyprctl_json(args):
    try:
        proc = subprocess.run(
            [HYPRCTL, *args],
            capture_output=True,
            text=True,
            check=True,
            timeout=HYPRCTL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return {}
    if len(proc.stdout) > HYPRCTL_MAX_OUTPUT:
        return {}
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}


def process_matches(pid, script_path, expected_start=None):
    cmdline_path = f"/proc/{pid}/cmdline"
    try:
        with open(cmdline_path, "rb") as handle:
            data = handle.read(64 * 1024)
    except OSError:
        return False
    real_script = os.path.realpath(script_path)
    matched = False
    for entry in data.split(b"\0"):
        if not entry:
            continue
        try:
            candidate = os.path.realpath(entry.decode())
        except (UnicodeDecodeError, OSError):
            continue
        if candidate == real_script:
            matched = True
            break
    if not matched:
        return False
    if expected_start is not None:
        # The recorded process incarnation is verified against the live start
        # time, closing the PID-reuse race definitively.
        if proc_start_time(pid) != expected_start:
            return False
    return True


def stop_existing(timeout=5.0):
    record = read_pid_record()
    if not record:
        return None
    pid = record.get("pid")
    script_path = record.get("script")
    expected_start = record.get("start")
    if not isinstance(pid, int) or not isinstance(script_path, str):
        remove_pid_record()
        return None
    if not process_matches(pid, script_path, expected_start):
        remove_pid_record()
        return None
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        remove_pid_record()
        return None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not process_matches(pid, script_path, expected_start):
            remove_pid_record()
            return True
        time.sleep(0.1)
    return False

POLL = 0.25          # seconds between position checks during idle
STABLE = 0.5         # seconds a deviation must persist before re-fitting
GRACE = 1.0          # suppress detection immediately after we apply
MOVE_THRESHOLD = 40  # logical px a float must deviate from its cell to matter
EVENT_DEBOUNCE = 0.3  # settle delay after an event-triggered layout change
MAX_EVENT_LINES_PER_TICK = 128  # bound on socket events handled per loop tick


def read_layout_opts():
    def _get(key):
        data = hyprctl_json(["getoption", "-j", key])
        return data if isinstance(data, dict) else {}

    gaps_in = 5
    gaps_out = 10
    border = 2
    try:
        gaps_in = int(_get("general:gaps_in").get("css", "5").split()[0])
    except Exception:
        pass
    try:
        gaps_out = int(_get("general:gaps_out").get("css", "10").split()[0])
    except Exception:
        pass
    try:
        border = int(_get("general:border_size").get("int", 2))
    except Exception:
        pass
    return gaps_in, gaps_out, border


GAPS_IN, GAPS_OUT, BORDER = read_layout_opts()


_ADDRESS_TOKEN_RE = re.compile(r'"address:([^"]*)"')
_NUM_TOKEN_RE = re.compile(r"\b(x|y|w|h)\s*=\s*(-?\d+)\b")
_DISPATCH_SHAPE_RE = re.compile(
    r"hl\.dsp\.window\.(float|resize|move)"
    r"\(\{ window = \"address:0x[0-9a-f]+\""
    r"(?:, (?:x|y|w|h) = -?\d+)*"
    r"(?:, action = \"(?:enable|disable)\"){0,1}"
    r"(?:, relative = (?:true|false)){0,1}"
    r" \}\)"
)


def _validate_dispatch(cmd):
    """Enforce a strict allowlist shape before any command reaches Hyprland.

    Every `"address:..."` token must be a bare hex window id and every
    geometry value (x/y/w/h) must be an integer literal, and the whole command
    must match the narrow `hl.dsp.window.<verb>({ ... })` grammar. This is the
    single enforcement point for strict address/coordinate validation so an
    unexpected value from an IPC event, snapshot, or config can never inject
    into a Hyprland command string. Returns the validated command, or None if
    unsafe.
    """
    if not isinstance(cmd, str) or not cmd:
        return None
    # Validate and normalize every window address token.
    def _repl(match):
        addr = match.group(1)
        if not ADDRESS_RE.fullmatch(addr):
            raise ValueError(addr)
        return '"address:' + addr.lower() + '"'

    try:
        cmd = _ADDRESS_TOKEN_RE.sub(_repl, cmd)
    except ValueError:
        return None
    # Ensure any present x/y/w/h values are plain integers (no expressions).
    for token in _NUM_TOKEN_RE.finditer(cmd):
        try:
            int(token.group(2))
        except ValueError:
            return None
    # Whole-command grammar allowlist.
    if not _DISPATCH_SHAPE_RE.fullmatch(cmd):
        return None
    return cmd


def dispatch(cmd):
    """Send a dispatch straight to the Hyprland IPC socket.

    Spawning `hyprctl` costs ~5ms per call; the raw socket is ~0.1ms. The
    ordered restore sends one command per window, so this shaves real time off
    the toggle-off sequence. Falls back to a `hyprctl` subprocess if the socket
    is unavailable.
    """
    validated = _validate_dispatch(cmd)
    if validated is None:
        if os.environ.get("EQUALIZE_DEBUG_SEND"):
            print(f"DISPATCH-REJECTED {cmd!r}", file=sys.stderr, flush=True)
        return
    cmd = validated
    try:
        if os.environ.get("EQUALIZE_DEBUG_SEND"):
            print(f"DISPATCH {cmd}", file=sys.stderr, flush=True)
    except Exception:
        pass
    try:
        if IPC_SOCKET and os.path.exists(IPC_SOCKET):
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(HYPRCTL_TIMEOUT)
                s.connect(IPC_SOCKET)
                s.sendall(("dispatch " + cmd + "\n").encode())
                while s.recv(65536):
                    pass
            return
    except (OSError, socket.timeout):
        pass
    try:
        subprocess.run(
            [HYPRCTL, "dispatch", cmd],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=HYPRCTL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        pass


def monitor_and_ws():
    monitors = hyprctl_json(["monitors", "-j"])
    if not isinstance(monitors, list):
        return None, None
    mon = next((m for m in monitors if isinstance(m, dict) and m.get("focused")), None)
    if mon is None:
        return None, None
    ws_payload = hyprctl_json(["activeworkspace", "-j"])
    ws = ws_payload.get("id") if isinstance(ws_payload, dict) else None
    return mon, ws


def current_rows(mon, ws):
    wins = hyprctl_json(["clients", "-j"])
    rows = []
    if not isinstance(wins, list):
        return rows
    for w in wins:
        if not isinstance(w, dict):
            continue
        addr = normalize_address(w.get("address"))
        if not addr:
            continue
        workspace = w.get("workspace", {}) or {}
        if workspace.get("id") != ws:
            continue
        if not (w.get("mapped") and not w.get("hidden") and not w.get("fullscreen")):
            continue
        row = dict(w)
        row["address"] = addr
        rows.append(row)
    return rows


def focused_address():
    payload = hyprctl_json(["activewindow", "-j"])
    if isinstance(payload, dict):
        return normalize_address(payload.get("address"))
    return None


def cursor_window(mon, ws):
    """Address of the frontmost managed window on `ws` under the cursor.

    Reads `hyprctl cursorpos` (logical coordinates); among windows whose rect
    contains the point, the one with the highest focusHistoryID is the
    frontmost. Returns None when the cursor sits over no managed window.
    """
    try:
        proc = subprocess.run(
            [HYPRCTL, "cursorpos"],
            capture_output=True,
            text=True,
            check=True,
            timeout=HYPRCTL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return None
    try:
        cx, cy = (int(v) for v in proc.stdout.strip().split(","))
    except (ValueError, AttributeError):
        return None
    best, best_hist = None, -1
    for w in current_rows(mon, ws):
        x, y = w["at"]
        ww, hh = w["size"]
        if x <= cx <= x + ww and y <= cy <= y + hh:
            hist = int(w.get("focusHistoryID", -1) or -1)
            if hist > best_hist:
                best_hist = hist
                best = w["address"]
    return best


def geometry(mon):
    scale = mon.get("scale") or 1.0
    log_w = int(mon["width"] / scale)
    log_h = int(mon["height"] / scale)
    rl, rt, rr, rb = (int(x) for x in (mon.get("reserved") or [0, 0, 0, 0]))
    return {
        "l": rl,
        "t": rt,
        "w": log_w - rl - rr,
        "h": log_h - rt - rb,
    }


def cell_list(mon, ws):
    """Cells as (cx_center, cy_center, x, y, w, h), inset by outer gap+border."""
    g = geometry(mon)
    rows = current_rows(mon, ws)
    n = len(rows)
    if n == 0:
        return []
    cols = max(1, math.ceil(math.sqrt(n)))
    rows_n = math.ceil(n / cols)

    pad = GAPS_OUT + BORDER
    rx = g["l"] + pad
    ry = g["t"] + pad
    rw = g["w"] - 2 * pad
    rh = g["h"] - 2 * pad

    # Floating windows draw their border/glow outward past the box edge, which
    # eats into a small gap. Use a generous box gap so a visible background gap
    # remains between tiles (natural Hyprland tiling uses ~14px box separation;
    # floating needs a bit more to compensate for the outward-drawn border).
    inner_gap = 18

    def edges(origin, span, count, gap):
        """Integer left edges + widths, with an exact `gap` between tiles."""
        tw = (span - gap * (count - 1)) / count
        lefts = [round(origin + c * (tw + gap)) for c in range(count)]
        widths = []
        for c in range(count):
            right = lefts[c + 1] if c + 1 < count else origin + span
            widths.append(right - lefts[c] - (gap if c + 1 < count else 0))
        return lefts, widths

    xs, ws = edges(rx, rw, cols, inner_gap)
    ys, hs = edges(ry, rh, rows_n, inner_gap)

    cells = []
    idx = 0
    for r in range(rows_n):
        for c in range(cols):
            if idx >= n:
                break
            x, y = xs[c], ys[r]
            w, h = ws[c], hs[r]
            cx = x + w / 2.0
            cy = y + h / 2.0
            cells.append((cx, cy, x, y, w, h))
            idx += 1
    return cells


def nearest_layout(mon, ws, prio_order=None, force_first_addr=None):
    """Assign each window to a distinct cell, honoring drop position.

    prio_order is a list of addresses (the windows the user just moved).
    Those are assigned to the cell nearest their current position first
    (so a dropped window keeps its drop cell), then the remaining windows
    fill the leftover cells by nearest distance.

    force_first_addr, when given, claims the first (top-left) cell for that
    window before anything else -- used on the initial equalize so the window
    under the cursor anchors the grid while everyone else lays out normally.

    Returns (targets, applied) where targets is a list of
    (address, x, y, w, h) and applied maps address -> cell index.
    """
    cells = cell_list(mon, ws)
    rows = current_rows(mon, ws)
    n = len(rows)
    if n == 0:
        return [], {}

    prio_order = prio_order or []
    index_of = {r["address"]: i for i, r in enumerate(rows)}
    cells_rem = set(range(n))
    assignment = {}

    if force_first_addr is not None and force_first_addr in index_of:
        assignment[index_of[force_first_addr]] = 0
        cells_rem.discard(0)

    def nearest_unused_cell(cx, cy):
        best, bd = None, float("inf")
        for j in cells_rem:
            ccx, ccy = cells[j][0], cells[j][1]
            d = (cx - ccx) ** 2 + (cy - ccy) ** 2
            if d < bd:
                bd = d
                best = j
        return best

    def pick(window_index):
        w = rows[window_index]
        cx = w["at"][0] + w["size"][0] / 2.0
        cy = w["at"][1] + w["size"][1] / 2.0
        j = nearest_unused_cell(cx, cy)
        assignment[window_index] = j
        cells_rem.discard(j)

    # 1) Priority (dragged) windows claim their nearest cell first.
    for addr in prio_order:
        idx = index_of.get(addr)
        if idx is not None and idx not in assignment:
            pick(idx)
    # 2) Remaining windows fill leftover cells by nearest distance (greedy).
    remaining = [i for i in range(n) if i not in assignment]
    centers = [
        (r["at"][0] + r["size"][0] / 2.0, r["at"][1] + r["size"][1] / 2.0)
        for r in rows
    ]
    while remaining:
        best = None
        bd = float("inf")
        for i in remaining:
            wx, wy = centers[i]
            for j in cells_rem:
                cx, cy = cells[j][0], cells[j][1]
                d = (wx - cx) ** 2 + (wy - cy) ** 2
                if d < bd:
                    bd = d
                    best = (i, j)
        i, j = best
        assignment[i] = j
        remaining.remove(i)
        cells_rem.discard(j)

    targets = []
    for i, j in assignment.items():
        _, _, x, y, w, h = cells[j]
        targets.append((rows[i]["address"], x, y, w, h))
    applied = {rows[i]["address"]: j for i, j in assignment.items()}
    return targets, applied


def fill_target_cell(mon, ws, fill_dir):
    """Cell index of the tile that `fill_dir` stretches, or None when not applicable.

    horizontal -> the last cell (bottom-right; stretched rightward to row end).
    vertical   -> the cell directly above the empty bottom-right corner
                  (stretched downward to the work area bottom).
    Both require a partial last row (n % cols != 0) and at least two windows.
    """
    if fill_dir in (None, "off"):
        return None
    cells = cell_list(mon, ws)
    n = len(cells)
    if n < 2 or n % math.ceil(math.sqrt(n)) == 0:
        return None
    cols = max(1, math.ceil(math.sqrt(n)))
    if fill_dir == "horizontal":
        return n - 1
    rows_n = math.ceil(n / cols)
    idx = (rows_n - 2) * cols + (cols - 1)
    return idx if 0 <= idx < n else None


def extend_last_cell(mon, targets, applied, fill_dir):
    if fill_dir in (None, "off") or len(targets) < 2 or not applied:
        return targets
    n = len(targets)
    cols = max(1, math.ceil(math.sqrt(n)))
    if n % cols == 0:
        return targets
    rows_n = math.ceil(n / cols)
    g = geometry(mon)
    pad = GAPS_OUT + BORDER
    rx = g["l"] + pad
    ry = g["t"] + pad
    rw = g["w"] - 2 * pad
    rh = g["h"] - 2 * pad

    if fill_dir == "vertical":
        target_cell = (rows_n - 2) * cols + (cols - 1)
        if not (0 <= target_cell < n):
            return targets
        addr = next((a for a, c in applied.items() if c == target_cell), None)
        if addr is None:
            return targets
        ti = next((i for i, (a2, *_r) in enumerate(targets) if a2 == addr), None)
        if ti is None:
            return targets
        a2, x, y, w, h = targets[ti]
        new_h = int(round((ry + rh) - y))
        if new_h > h:
            targets[ti] = (a2, x, y, w, new_h)
        return targets

    # horizontal (legacy default)
    last_cell = max(applied.values(), default=None)
    if last_cell is None or last_cell // cols != rows_n - 1:
        return targets
    target_idx = None
    for i, (addr, *_rest) in enumerate(targets):
        if applied.get(addr) == last_cell:
            target_idx = i
            break
    if target_idx is None:
        return targets
    row_end = rx + rw
    addr, x, y, w, h = targets[target_idx]
    new_w = int(round(row_end - x))
    if new_w > w:
        targets[target_idx] = (addr, x, y, new_w, h)
    return targets


def apply_fill_in_place(mon, ws, fill_dir, current_rects, cell_map, stretch_state):
    """Adjust only the stretched tile(s) when the fill direction changes.

    `stretch_state` is the previous (addr, dir) we stretched, or (None, None).
    Returns (updated_rects, new_stretch_state).
    """
    cells = cell_list(mon, ws)
    n = len(cells)
    g = geometry(mon)
    pad = GAPS_OUT + BORDER
    row_end = g["l"] + pad + (g["w"] - 2 * pad)
    bottom = g["t"] + pad + (g["h"] - 2 * pad)

    updated = dict(current_rects)
    prev_addr, prev_dir = stretch_state

    def natural_cell_for(addr):
        idx = cell_map.get(addr)
        if idx is None or idx >= len(cells):
            return None
        _, _, nx, ny, nw, nh = cells[idx]
        return (nx, ny, nw, nh)

    def restore_tile(addr):
        nat = natural_cell_for(addr)
        if nat is None:
            return
        nx, ny, nw, nh = nat
        dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {nw}, y = {nh}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {nx}, y = {ny}, relative = false }})')
        updated[addr] = (nx, ny, nw, nh)

    # Restore the previously-stretched tile if it is no longer the target.
    new_target_cell = fill_target_cell(mon, ws, fill_dir)
    new_target_addr = None
    if new_target_cell is not None:
        new_target_addr = next((a for a, c in cell_map.items() if c == new_target_cell), None)

    if prev_addr and (prev_addr != new_target_addr or fill_dir == "off"):
        restore_tile(prev_addr)

    if fill_dir == "off" or new_target_addr is None or new_target_cell is None:
        return updated, (None, None)

    # Stretch the new target tile in place.
    _, _, tx, ty, tw, th = cells[new_target_cell]
    ax, ay, aw, ah = updated.get(new_target_addr, (tx, ty, tw, th))
    if fill_dir == "horizontal":
        new_w = int(round(row_end - ax))
        new_rect = (ax, ay, new_w, ah) if new_w > aw else (ax, ay, aw, ah)
    else:  # vertical
        new_h = int(round(bottom - ay))
        new_rect = (ax, ay, aw, new_h) if new_h > ah else (ax, ay, aw, ah)

    if new_rect != updated.get(new_target_addr):
        nx, ny, nw, nh = new_rect
        dispatch(f'hl.dsp.window.resize({{ window = "address:{new_target_addr}", x = {nw}, y = {nh}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{new_target_addr}", x = {nx}, y = {ny}, relative = false }})')
        updated[new_target_addr] = new_rect

    return updated, (new_target_addr, fill_dir)


def apply_grid(mon, ws, prio_order=None, fill_dir="off", force_first_addr=None):
    """Float + equalize all managed windows. Returns (applied_map, sizes, rects)."""
    targets, applied = nearest_layout(mon, ws, prio_order, force_first_addr)
    sizes = {}
    rects = {}
    # Phase 1: float every window first.  Hyprland assigns each window a
    # default floating size on the transition; we need that to settle before
    # issuing the precise resize/move, otherwise the resize can land on the
    # pre-float geometry or be silently dropped.
    for addr, x, y, w, h in targets:
        sizes[addr] = (w, h)
        rects[addr] = (x, y, w, h)
        dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "enable" }})')
    # Give Hyprland a beat to finish transitioning all windows to floating.
    time.sleep(0.05)
    # Phase 2: resize + move every window to its exact cell.
    for addr, x, y, w, h in targets:
        dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {w}, y = {h}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y}, relative = false }})')
    # Phase 3: some apps (e.g. Krita) enforce a minimum size that is larger
    # than the equal cell.  Re-compute the grid so each column/row is at least
    # as large as the largest window assigned to it, so the oversized windows
    # stop overlapping their neighbours.
    time.sleep(0.05)
    applied, sizes, rects = _fit_min_sizes(mon, ws, targets, applied, sizes, rects)
    # Phase 4: fill-stretch the last cell, then dispatch only what changed.
    fitted = [(a, *(rects.get(a, (x, y, w, h)))) for a, x, y, w, h in targets]
    stretched = extend_last_cell(mon, fitted, applied, fill_dir)
    for addr, x, y, w, h in stretched:
        px, py, pw, ph = rects.get(addr, (x, y, w, h))
        if (px, py, pw, ph) != (x, y, w, h):
            dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {w}, y = {h}, relative = false }})')
            dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y}, relative = false }})')
            rects[addr] = (x, y, w, h)
            sizes[addr] = (w, h)
    return applied, sizes, rects


def _fit_min_sizes(mon, ws, targets, applied, fallback_sizes, fallback_rects):
    """Iteratively re-layout the grid so columns/rows grow to fit
    min-size-constrained windows.

    Each pass measures how far every window's ACTUAL size (what Hyprland
    refused to shrink it below) exceeds its equal cell and grows those
    columns/rows; flexible columns split the leftover.  Because shrinking one
    column can surface a constraint in its neighbour, passes repeat until no
    window overflows its cell, or a small iteration cap is reached.

    Windows are measured against their target cell (not their current
    position, which is unreliable after Hyprland clamps an oversized window),
    so multiple constrained windows do not cascade position errors.

    Returns (applied, sizes, rects).
    """
    g = geometry(mon)
    n = len(targets)
    if n <= 1:
        return applied, fallback_sizes, fallback_rects

    cols = max(1, math.ceil(math.sqrt(n)))
    rows_n = math.ceil(n / cols)
    G = 18
    pad = GAPS_OUT + BORDER
    rx = g["l"] + pad
    ry = g["t"] + pad
    rw = g["w"] - 2 * pad
    rh = g["h"] - 2 * pad

    base_rects = {a: (x, y, w, h) for a, x, y, w, h in targets}
    cells = {}
    for addr, x, y, w, h in targets:
        cell = applied.get(addr)
        if cell is not None:
            cells[addr] = cell
    if not cells:
        return applied, fallback_sizes, fallback_rects

    def actual_sizes():
        out = {}
        for ww in current_rows(mon, ws):
            out[ww["address"]] = (int(ww["size"][0]), int(ww["size"][1]))
        return out

    def distribute(need, span, gap, count):
        """Return (lefts, widths) that tile `span` exactly.  Slots whose need
        exceeds the equal share keep it; flexible slots split the leftover.
        If the needs alone overflow the span, everything scales down
        proportionally so the layout still fits."""
        total_gaps = gap * (count - 1)
        available = span - total_gaps
        base = available / count
        if sum(need) >= available:
            scale = available / sum(need) if sum(need) > 0 else 0
            widths = [max(1, int(round(nd * scale))) for nd in need]
        else:
            fixed = [i for i in range(count) if need[i] > base]
            fixed_total = sum(need[i] for i in fixed)
            leftover = available - fixed_total
            flex = [i for i in range(count) if i not in fixed]
            each = leftover / len(flex) if flex else 0
            widths = [
                int(round(need[i])) if i in fixed else int(round(each))
                for i in range(count)
            ]
        lefts = [0] * count
        cur = 0
        for i in range(count):
            lefts[i] = cur
            cur += widths[i] + gap
        return lefts, widths

    rects = dict(base_rects)
    sizes = {a: (b[2], b[3]) for a, b in base_rects.items()}
    for _ in range(6):
        actual = actual_sizes()
        col_need = [0.0] * cols
        row_need = [0.0] * rows_n
        any_excess = False
        for addr, cell in cells.items():
            c = cell % cols
            r = cell // cols
            w, h = base_rects[addr][2], base_rects[addr][3]
            aw, ah = actual.get(addr, (w, h))
            if aw > w + 4:
                col_need[c] = max(col_need[c], aw)
                any_excess = True
            if ah > h + 4:
                row_need[r] = max(row_need[r], ah)
                any_excess = True
        if not any_excess:
            break
        col_lefts, col_widths = distribute(col_need, rw, G, cols)
        row_lefts, row_heights = distribute(row_need, rh, G, rows_n)
        next_rects = {}
        for addr, cell in cells.items():
            c = cell % cols
            r = cell // cols
            nx, ny = rx + col_lefts[c], ry + row_lefts[r]
            nw, nh = col_widths[c], row_heights[r]
            next_rects[addr] = (nx, ny, nw, nh)
        sizes = {a: (next_rects[a][2], next_rects[a][3]) for a in cells}
        # Only dispatch windows whose rectangle actually changed, so later
        # passes don't re-trigger a visible shuffle on settled tiles.
        moved = False
        for addr, (nx, ny, nw, nh) in next_rects.items():
            if rects.get(addr) == (nx, ny, nw, nh):
                continue
            dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {nw}, y = {nh}, relative = false }})')
            dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {nx}, y = {ny}, relative = false }})')
            moved = True
        rects = next_rects
        if not moved:
            continue
        time.sleep(0.06)

    return applied, sizes, rects


def resize_fit_layout(mon, ws, pinned_addr):
    """Re-fit a grid after one window was resized (via SUPER +/-).

    The resized ("pinned") window keeps its current size and position. Every
    other window is re-equalized to share the leftover space: the pinned
    window's column is its new width and its row its new height, and the
    remaining columns/rows split the rest equally with exact gaps.

    Returns (targets, applied) where targets lists (address, x, y, w, h).
    The pinned window is NOT moved/resized (targets excludes it).
    """
    g = geometry(mon)
    rows = current_rows(mon, ws)
    n = len(rows)
    pin = None
    for w in rows:
        if w["address"] == pinned_addr:
            pin = w
            break
    if pin is None or n <= 1:
        return [], {}

    cols = max(1, math.ceil(math.sqrt(n)))
    rows_n = math.ceil(n / cols)
    pad = GAPS_OUT + BORDER
    rx = g["l"] + pad
    ry = g["t"] + pad
    rw = g["w"] - 2 * pad
    rh = g["h"] - 2 * pad
    G = 18

    px, py = pin["at"]
    pw, ph = pin["size"]
    # Keep the pin inside the region no matter how it was resized.
    pw = max(1, min(pw, rw))
    ph = max(1, min(ph, rh))
    # A resize is center-anchored: the window's center stays put while it
    # grows/shrinks, but its top-left can drift (even off-screen). Anchor the
    # pin by its stable center and recompute its top-left from that, then clamp
    # the whole box inside the region so the rest of the grid tiles around the
    # pin on-screen rather than spilling off the left/top.
    px = (px + pw / 2.0) - pw / 2.0
    py = (py + ph / 2.0) - ph / 2.0
    px = max(rx, min(px, rx + rw - pw))
    py = max(ry, min(py, ry + rh - ph))

    # Enclosure index for the pin (row-major), matched by address.
    pin_idx = next(i for i, w in enumerate(rows) if w["address"] == pinned_addr)
    # The pin's effective row/col comes from its CLAMPED position (it may have
    # been pushed to a different cell than it began in), not its original index.
    def edges(origin, span, count, gap):
        tw = (span - gap * (count - 1)) / count
        return [origin + c * (tw + gap) + tw / 2.0 for c in range(count)]
    pcx = px + pw / 2.0
    pcy = py + ph / 2.0
    ccx = edges(rx, rw, cols, G)
    ccy = edges(ry, rh, rows_n, G)
    pc = min(range(cols), key=lambda c: abs(ccx[c] - pcx))
    pr = min(range(rows_n), key=lambda r: abs(ccy[r] - pcy))
    # Each window's own current center, for nearest-free-slot matching.
    centers = [(w["at"][0] + w["size"][0] / 2.0, w["at"][1] + w["size"][1] / 2.0) for w in rows]

    def distribute(sizes, gap, first, span):
        # sizes = list of per-slot sizes (pin slot already sized). Returns
        # (positions, sizes). Slots at `pinned_slot` keep their size and edge;
        # free slots split the remaining span equally.
        pass

    # Build column geometry: column `pc` has width pw with left edge px; other
    # columns share the leftover, equal across the spans left/right of pc.
    def col_geom():
        left_span = px - rx
        right_span = (rx + rw) - (px + pw)
        xs = [0.0] * cols
        ws_ = [0.0] * cols
        ws_[pc] = pw
        xs[pc] = px
        if pc > 0:
            # pc gaps: (pc-1) internal + 1 between leftmost group and the pin.
            wl = (left_span - G * pc) / pc
            if wl < 0:
                wl = 0
            for i in range(pc - 1, -1, -1):
                xs[i] = px - G * (pc - i) - wl * (pc - i)
                ws_[i] = wl
        if pc < cols - 1:
            m = cols - 1 - pc
            wl = (right_span - G * m) / m
            if wl < 0:
                wl = 0
            for i in range(pc + 1, cols):
                xs[i] = px + pw + G * (i - pc) + wl * (i - pc - 1)
                ws_[i] = wl
        return xs, ws_

    def row_geom():
        top_span = py - ry
        bottom_span = (ry + rh) - (py + ph)
        ys = [0.0] * rows_n
        hs_ = [0.0] * rows_n
        hs_[pr] = ph
        ys[pr] = py
        if pr > 0:
            # pr gaps: (pr-1) internal + 1 between top group and the pin.
            hl_ = (top_span - G * pr) / pr
            if hl_ < 0:
                hl_ = 0
            for i in range(pr - 1, -1, -1):
                ys[i] = py - G * (pr - i) - hl_ * (pr - i)
                hs_[i] = hl_
        if pr < rows_n - 1:
            m = rows_n - 1 - pr
            hl_ = (bottom_span - G * m) / m
            if hl_ < 0:
                hl_ = 0
            for i in range(pr + 1, rows_n):
                ys[i] = py + ph + G * (i - pr) + hl_ * (i - pr - 1)
                hs_[i] = hl_
        return ys, hs_

    xs, ws_ = col_geom()
    ys, hs_ = row_geom()

    # Recompute integer left edges and derive widths from them to prevent
    # ±1px overlap that independent rounding of position and size can cause.
    xs_int = [int(round(x)) for x in xs]
    ys_int = [int(round(y)) for y in ys]
    ws_int = []
    for c in range(cols):
        if c + 1 < cols:
            ws_int.append(xs_int[c + 1] - xs_int[c] - G)
        else:
            ws_int.append(int(round(rx + rw)) - xs_int[c])
    hs_int = []
    for r in range(rows_n):
        if r + 1 < rows_n:
            hs_int.append(ys_int[r + 1] - ys_int[r] - G)
        else:
            hs_int.append(int(round(ry + rh)) - ys_int[r])

    # Assign each (non-pin) window to the free slot nearest its center.
    cells = []
    for r in range(rows_n):
        for c in range(cols):
            cells.append((r, c))
    pin_cell = (pr, pc)
    free = [cell for cell in cells if cell != pin_cell]

    assigned = {}
    remaining = [i for i in range(n) if i != pin_idx]
    while remaining:
        best = None
        bd = float("inf")
        for i in remaining:
            wx, wy = centers[i]
            for (r, c) in free:
                x = xs[c] + ws_[c] / 2.0
                y = ys[r] + hs_[r] / 2.0
                d = (wx - x) ** 2 + (wy - y) ** 2
                if d < bd:
                    bd = d
                    best = (i, r, c)
        i, r, c = best
        assigned[i] = (r, c)
        remaining.remove(i)
        free.remove((r, c))

    targets = []
    applied = {}
    for i, (r, c) in assigned.items():
        x = xs_int[c]
        y = ys_int[r]
        w = ws_int[c]
        h = hs_int[r]
        targets.append((rows[i]["address"], x, y, w, h))
        applied[rows[i]["address"]] = (r, c)
    applied[pin["address"]] = (pr, pc)
    return targets, applied, (int(round(px)), int(round(py)), int(round(pw)), int(round(ph)))


def apply_resize_fit(mon, ws, pinned_addr, fill_dir="off"):
    targets, applied, pin_box = resize_fit_layout(mon, ws, pinned_addr)
    pin_x, pin_y, pin_w, pin_h = pin_box
    combined = list(targets) + [(pinned_addr, pin_x, pin_y, pin_w, pin_h)]
    combined = extend_last_cell(mon, combined, applied, fill_dir)
    targets = []
    sizes = {}
    rects = {}
    for addr, x, y, w, h in combined:
        rects[addr] = (x, y, w, h)
        if addr == pinned_addr:
            pin_x, pin_y, pin_w, pin_h = x, y, w, h
        else:
            targets.append((addr, x, y, w, h))
        sizes[addr] = (w, h)
    # Keep the pinned (resized) window's new size (clamping only if it would
    # overflow the region) and move its box fully on-screen, since a
    # center-anchored resize can otherwise push its top-left off-region.
    # Phase 1: ensure every window is floating.
    dispatch(f'hl.dsp.window.float({{ window = "address:{pinned_addr}", action = "enable" }})')
    for addr, x, y, w, h in targets:
        dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "enable" }})')
    time.sleep(0.05)
    # Phase 2: resize + move to exact positions.
    dispatch(f'hl.dsp.window.resize({{ window = "address:{pinned_addr}", x = {pin_w}, y = {pin_h}, relative = false }})')
    dispatch(f'hl.dsp.window.move({{ window = "address:{pinned_addr}", x = {pin_x}, y = {pin_y}, relative = false }})')
    for addr, x, y, w, h in targets:
        dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {w}, y = {h}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y}, relative = false }})')
    return applied, sizes, rects


def off_layout(mon, ws, expected):
    """Addresses that drifted away from the last applied rectangle."""
    if not expected:
        return set()
    off = set()
    for w in current_rows(mon, ws):
        addr = w["address"]
        if addr not in expected:
            continue
        exp_x, exp_y, exp_w, exp_h = expected[addr]
        act_x = int(w["at"][0])
        act_y = int(w["at"][1])
        act_w = int(w["size"][0])
        act_h = int(w["size"][1])
        dx = abs(act_x - exp_x)
        dy = abs(act_y - exp_y)
        dw = abs(act_w - exp_w)
        dh = abs(act_h - exp_h)
        if max(dx, dy, dw, dh) > MOVE_THRESHOLD:
            off.add(addr)
    return off


def release_ws(ws):
    """De-float every window on a workspace so it returns to normal tiling."""
    wins = hyprctl_json(["clients", "-j"])
    if not isinstance(wins, list):
        return
    for w in wins:
        if not isinstance(w, dict):
            continue
        addr = normalize_address(w.get("address"))
        if not addr:
            continue
        if (
            w.get("workspace", {}).get("id") == ws
            and w.get("mapped")
            and not w.get("hidden")
            and w.get("floating")
        ):
            dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "disable" }})')


def _current_mapped(ws):
    """Managed (mapped, visible, non-fullscreen) windows currently on `ws`."""
    wins = hyprctl_json(["clients", "-j"])
    rows = []
    if not isinstance(wins, list):
        return rows
    for w in wins:
        if not isinstance(w, dict):
            continue
        addr = normalize_address(w.get("address"))
        if not addr:
            continue
        ws_id = (w.get("workspace") or {}).get("id")
        if ws_id != ws:
            continue
        if not (w.get("mapped") and not w.get("hidden") and not w.get("fullscreen")):
            continue
        rows.append(w)
    return rows


def restore_snapshot(ws):
    """Toggle-OFF: release the grid back to Hyprland's native tiling.

    De-floats every window on the workspace in one pass -- no ordering, no
    reconstruction. Dwindle re-tiles the workspace naturally into its own layout.
    (Hyprland exposes no split-tree API, so any attempt to recreate an arbitrary
    pre-grid arrangement exactly is approximate at best; releasing natively is
    fast, predictable, and never leaves windows stranded floating.) Any captured
    snapshot is discarded.
    """
    clear_snapshot(ws)
    release_ws(ws)


def run_daemon():
    if not os.path.exists(SOCKET):
        return
    reset_state()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(SOCKET)
    except OSError:
        sock.close()
        return

    now = time.monotonic()
    fill_dir = get_config_choice("fill_remainder")
    last_fill = fill_dir        # fill direction value we last acted on
    stretch_state = (None, None)  # (addr, dir) of tile we last stretched in place
    last_apply = 0.0         # monotonic time we last applied a layout
    pending_apply = None     # (due_time, ws) queued event apply
    fill_suppress_until = 0.0  # ignore our own fill-change events before this time
    off_state = (None, None)  # (off_seen frozenset, time first seen)
    current_map = {}         # address -> cell index of the layout we last applied
    current_rects = {}       # address -> (x, y, w, h) we last applied
    last_sizes = {}          # address -> (w, h) we last applied
    resized_seen = set()     # addresses we already pinned+refit for one size change
    grids = set()            # workspace ids currently gridded/preserved
    pending_events = deque() # socket events awaiting processing (bounded per tick)

    def snap_sizes(mon, ws):
        return {
            w["address"]: (int(w["size"][0]), int(w["size"][1]))
            for w in current_rows(mon, ws)
        }

    def reapply(mon, ws, prio=None, force_first=None):
        """Apply the equal grid and refresh tracking. Returns the cell map."""
        nonlocal last_sizes, resized_seen, current_rects, stretch_state
        m, s, rects = apply_grid(mon, ws, prio, fill_dir, force_first)
        last_sizes = s
        current_rects = rects
        resized_seen = set()
        # The fresh grid already incorporates any stretch via extend_last_cell.
        target_cell = fill_target_cell(mon, ws, fill_dir)
        addr = next((a for a, c in m.items() if c == target_cell), None) if target_cell is not None else None
        stretch_state = (addr, fill_dir) if addr else (None, None)
        return m

    def grid_if_needed(ws):
        """Grid `ws` if it is marked equalized and not yet gridded. Returns mon."""
        nonlocal current_map, last_sizes, resized_seen, last_apply, current_rects
        mon, cur = monitor_and_ws()
        if mon is None:
            return None
        wanted = load_wanted()
        if ws in wanted and ws not in grids:
            # The window under the cursor anchors the grid's top-left cell on
            # the initial equalize; the rest settle into nearest cells as normal.
            # Re-grids after drag/resize events deliberately do NOT use this.
            current_map = reapply(mon, ws, force_first=cursor_window(mon, ws))
            grids.add(ws)
            last_apply = now
        return mon

    try:
        while True:
            fill_dir = get_config_choice("fill_remainder")
            now = time.monotonic()
            wanted = load_wanted()

            # If the stretch direction changed while a grid is active, adjust the
            # affected tile(s) in place instead of re-laying-out the whole grid.
            if fill_dir != last_fill:
                mon_f, cur_f = monitor_and_ws()
                if mon_f is not None and cur_f in grids and current_rects:
                    mon_f, cur_f = monitor_and_ws()
                    try:
                        if os.environ.get("EQUALIZE_DEBUG"):
                            print(f"DBG fill change {last_fill}->{fill_dir} ws={cur_f} rects={len(current_rects)} cmap={len(current_map)} prev={stretch_state}", file=sys.stderr, flush=True)
                        new_rects, stretch_state = apply_fill_in_place(
                            mon_f, cur_f, fill_dir, current_rects, current_map, stretch_state
                        )
                        current_rects = new_rects
                        # Refresh sizes snapshot so the resize detector does not
                        # mistake our own stretch for a user resize and re-fit the
                        # whole grid on top of it.
                        last_sizes = {a: (r[2], r[3]) for a, r in new_rects.items()}
                        last_apply = now
                        off_state = (None, None)
                        pending_apply = None
                        fill_suppress_until = now + GRACE
                    except Exception:
                        traceback.print_exc()
                last_fill = fill_dir

            # Release grids that are no longer marked equalized (toggle OFF).
            for wid in list(grids):
                if wid not in wanted:
                    # De-float every window (plain release) so the layout engine
                    # re-tiles the workspace; consumes any captured snapshot.
                    restore_snapshot(wid)
                    grids.discard(wid)
                    current_map = {}
                    current_rects = {}
                    stretch_state = (None, None)
                    off_state = (None, None)

            mon, cur = monitor_and_ws()
            if mon is not None:
                # Grid the active workspace if it is currently marked equalized.
                grid_if_needed(cur)

            # 1) Process any event-triggered (debounced) re-grid for the managed ws.
            if pending_apply is not None:
                due, wid = pending_apply
                if now >= due:
                    mon, acur = monitor_and_ws()
                    if mon is not None and wid in grids:
                        current_map = reapply(mon, wid)
                        last_apply = now
                    pending_apply = None

            # 2) Drag-drop / resize detection on the active gridded workspace.
            if mon is not None and cur in grids and now - last_apply > GRACE:
                try:
                    sizes_now = snap_sizes(mon, cur)
                    # 2a) A window was resized (SUPER +/-): pinch it and re-fit the
                    #     others to the leftover space. Only for the focused window.
                    foc = focused_address()
                    if (
                        foc
                        and foc in sizes_now
                        and foc in last_sizes
                        and foc not in resized_seen
                    ):
                        w0, h0 = last_sizes[foc]
                        w1, h1 = sizes_now[foc]
                        if abs(w1 - w0) + abs(h1 - h0) >= 6:
                            _, s, rects = apply_resize_fit(mon, cur, foc, fill_dir)
                            last_sizes = s
                            current_rects = rects
                            resized_seen.add(foc)
                            current_map = {}
                            stretch_state = (None, None)
                            last_apply = now
                            off_state = (None, None)
                            continue
                    # 2b) Drag-drop detection (a window moved to a different cell).
                    off = off_layout(mon, cur, current_rects)
                    if off:
                        seen, since = off_state
                        if seen == off:
                            if now - since >= STABLE:
                                current_map = reapply(mon, cur, list(off))
                                last_apply = now
                                off_state = (None, None)
                        else:
                            off_state = (off, now)
                    else:
                        off_state = (None, None)
                except Exception:
                    traceback.print_exc()

            # 3) Read available socket events into the pending queue. Each
            # recv is capped (16 KiB) and only ever appended to the queue.
            r, _, _ = select.select([sock], [], [], POLL)
            if sock in r:
                try:
                    data = sock.recv(16384).decode("utf-8", "ignore")
                except OSError:
                    break
                if not data:
                    break
                pending_events.extend(data.splitlines())

            # 4) Drain at most MAX_EVENT_LINES_PER_TICK queued events this
            # tick so a burst/flood of socket events can never make a single
            # loop iteration perform unbounded work; any backlog simply
            # carries over to the next tick.
            processed_events = 0
            while pending_events and processed_events < MAX_EVENT_LINES_PER_TICK:
                line = pending_events.popleft()
                processed_events += 1
                mon, cur = monitor_and_ws()
                if mon is None:
                    continue
                # If the active workspace changed to a newly equalized one that
                # isn't gridded yet, grid it. Desktops already gridded stay
                # preserved (we never released them on switch-away).
                grid_if_needed(cur)
                if cur in grids:
                    # Ignore move/float events we just generated ourselves by
                    # stretching a tile in place (see apply_fill_in_place).
                    suppressed = time.monotonic() < fill_suppress_until
                    # Ignore move/float events from the apply we just ran; the
                    # debounced re-apply they would schedule is what makes the
                    # toggle look like a double refresh.
                    self_applied = now - last_apply < GRACE
                    if line.startswith("movewindowv2>>") and not suppressed and not self_applied:
                        raw = line[len("movewindowv2>>"):].split(",")
                        addr = normalize_address(raw[0]) if raw else None
                        try:
                            target_ws = int(raw[1]) if len(raw) > 1 else None
                        except (IndexError, ValueError):
                            target_ws = None
                        if addr and target_ws is not None and target_ws != cur:
                            # Left the grid for another desktop: tile normally there.
                            dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "disable" }})')
                        pending_apply = (now + EVENT_DEBOUNCE, cur)
                    elif line.startswith("movewindow>>") and not suppressed and not self_applied:
                        addr = normalize_address(line[len("movewindow>>"):].split(",")[0])
                        if addr:
                            dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "disable" }})')
                        pending_apply = (now + EVENT_DEBOUNCE, cur)
                    elif line.startswith(("openwindow>>", "closewindow>>")) and not suppressed:
                        pending_apply = (now + EVENT_DEBOUNCE, cur)
                    elif line.startswith("changefloatingmode>>") and not suppressed and not self_applied:
                        pending_apply = (now + EVENT_DEBOUNCE, cur)
    finally:
        try:
            sock.close()
        except OSError:
            pass


def parse_args():
    parser = argparse.ArgumentParser(description="HyprTile equalizer watcher")
    parser.add_argument(
        "--stop",
        action="store_true",
        help="terminate the currently running watcher instance",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    if args.stop:
        stopped = stop_existing()
        # Nothing to stop is not an error; a verified process that exceeded
        # the stop deadline is.
        return 1 if stopped is False else 0

    global LOCK_FD
    try:
        LOCK_FD = acquire_watcher_lock()
    except BlockingIOError:
        return 0

    def cleanup():
        global LOCK_FD
        remove_pid_record()
        if LOCK_FD is not None:
            try:
                os.close(LOCK_FD)
            except OSError:
                pass
            LOCK_FD = None

    atexit.register(cleanup)

    def _handle_exit(signum, _frame):
        cleanup()
        sys.exit(0)

    try:
        signal.signal(signal.SIGTERM, _handle_exit)
        signal.signal(signal.SIGINT, _handle_exit)
    except Exception:
        pass

    write_pid_record(os.getpid(), SCRIPT_PATH)
    try:
        run_daemon()
    finally:
        cleanup()
    return 0


if __name__ == "__main__":
    sys.exit(main())
