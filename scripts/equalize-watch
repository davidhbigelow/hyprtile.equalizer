def load_wanted():
    """Set of workspace ids currently marked equalized."""
    return load_workspace_ids()


def reset_state():
    """Start each session fresh: no desktop is equalized until SUPER+E is pressed."""
    try:
        clear_workspace_ids()
    except OSError:
        pass

HYPRCTL_TIMEOUT = float(os.environ.get("EQUALIZE_HYPRCTL_TIMEOUT", "1.5"))
HYPRCTL_MAX_OUTPUT = int(
    os.environ.get("EQUALIZE_HYPRCTL_MAX_OUTPUT", str(512 * 1024))
)
ADDRESS_RE = re.compile(r"^0x[0-9a-fA-F]+$")
LOCK_FD = None


def normalize_address(value):
    if isinstance(value, str):
        token = value.strip()
        if token.lower().startswith("0x"):
            token = token[2:]
        if token and re.fullmatch(r"[0-9a-fA-F]+", token):
            return "0x" + token.lower()
    return None


def hyprctl_json(args):
    try:
        proc = subprocess.run(
            [HYPRCTL, *args],
            capture_output=True,
            text=True,
            check=True,
            timeout=HYPRCTL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return {}
    if len(proc.stdout) > HYPRCTL_MAX_OUTPUT:
        return {}
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}


def process_matches(pid, script_path, expected_start=None):
    cmdline_path = f"/proc/{pid}/cmdline"
    try:
        with open(cmdline_path, "rb") as handle:
            data = handle.read(64 * 1024)
    except OSError:
        return False
    real_script = os.path.realpath(script_path)
    matched = False
    for entry in data.split(b"\0"):
        if not entry:
            continue
        try:
            candidate = os.path.realpath(entry.decode())
        except (UnicodeDecodeError, OSError):
            continue
        if candidate == real_script:
            matched = True
            break
    if not matched:
        return False
    if expected_start is not None:
        # The recorded process incarnation is verified against the live start
        # time, closing the PID-reuse race definitively.
        if proc_start_time(pid) != expected_start:
            return False
    return True


def stop_existing(timeout=5.0):
    record = read_pid_record()
    if not record:
        return None
    pid = record.get("pid")
    script_path = record.get("script")
    expected_start = record.get("start")
    if not isinstance(pid, int) or not isinstance(script_path, str):
        remove_pid_record()
        return None
    if not process_matches(pid, script_path, expected_start):
        remove_pid_record()
        return None
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        remove_pid_record()
        return None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not process_matches(pid, script_path, expected_start):
            remove_pid_record()
            return True
        time.sleep(0.1)
    return False

POLL = 0.25          # seconds between position checks during idle
STABLE = 0.5         # seconds a deviation must persist before re-fitting
GRACE = 1.0          # suppress detection immediately after we apply
MOVE_THRESHOLD = 40  # logical px a float must deviate from its cell to matter
EVENT_DEBOUNCE = 0.3  # settle delay after an event-triggered layout change
MAX_EVENT_LINES_PER_TICK = 128  # bound on socket events handled per loop tick
GRID_GAP = 18
MIN_TILE_SIZE = 80


def read_layout_opts():
    def _get(key):
        data = hyprctl_json(["getoption", "-j", key])
        return data if isinstance(data, dict) else {}

    gaps_in = 5
    gaps_out = 10
    border = 2
    try:
        gaps_in = int(_get("general:gaps_in").get("css", "5").split()[0])
    except Exception:
        pass
    try:
        gaps_out = int(_get("general:gaps_out").get("css", "10").split()[0])
    except Exception:
        pass
    try:
        border = int(_get("general:border_size").get("int", 2))
    except Exception:
        pass
    return gaps_in, gaps_out, border


GAPS_IN, GAPS_OUT, BORDER = read_layout_opts()


_ADDRESS_TOKEN_RE = re.compile(r'"address:([^"]*)"')
_NUM_TOKEN_RE = re.compile(r"\b(x|y|w|h)\s*=\s*(-?\d+)\b")
_DISPATCH_SHAPE_RE = re.compile(
    r"hl\.dsp\.window\.(float|resize|move)"
    r"\(\{ window = \"address:0x[0-9a-f]+\""
    r"(?:, (?:x|y|w|h) = -?\d+)*"
    r"(?:, action = \"(?:enable|disable)\"){0,1}"
    r"(?:, relative = (?:true|false)){0,1}"
    r" \}\)"
)


def _validate_dispatch(cmd):
    """Enforce a strict allowlist shape before any command reaches Hyprland.

    Every `"address:..."` token must be a bare hex window id and every
    geometry value (x/y/w/h) must be an integer literal, and the whole command
    must match the narrow `hl.dsp.window.<verb>({ ... })` grammar. This is the
    single enforcement point for strict address/coordinate validation so an
    unexpected value from an IPC event, snapshot, or config can never inject
    into a Hyprland command string. Returns the validated command, or None if
    unsafe.
    """
    if not isinstance(cmd, str) or not cmd:
        return None
    # Validate and normalize every window address token.
    def _repl(match):
        addr = match.group(1)
        if not ADDRESS_RE.fullmatch(addr):
            raise ValueError(addr)
        return '"address:' + addr.lower() + '"'

    try:
        cmd = _ADDRESS_TOKEN_RE.sub(_repl, cmd)
    except ValueError:
        return None
    # Ensure any present x/y/w/h values are plain integers (no expressions).
    for token in _NUM_TOKEN_RE.finditer(cmd):
        try:
            int(token.group(2))
        except ValueError:
            return None
    # Whole-command grammar allowlist.
    if not _DISPATCH_SHAPE_RE.fullmatch(cmd):
        return None
    return cmd


def dispatch(cmd):
    """Send a dispatch straight to the Hyprland IPC socket.

    Spawning `hyprctl` costs ~5ms per call; the raw socket is ~0.1ms. The
    ordered restore sends one command per window, so this shaves real time off
    the toggle-off sequence. Falls back to a `hyprctl` subprocess if the socket
    is unavailable.
    """
    validated = _validate_dispatch(cmd)
    if validated is None:
        if os.environ.get("EQUALIZE_DEBUG_SEND"):
            print(f"DISPATCH-REJECTED {cmd!r}", file=sys.stderr, flush=True)
        return
    cmd = validated
    try:
        if os.environ.get("EQUALIZE_DEBUG_SEND"):
            print(f"DISPATCH {cmd}", file=sys.stderr, flush=True)
    except Exception:
        pass
    try:
        if IPC_SOCKET and verify_socket_path(IPC_SOCKET, ".socket.sock"):
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(HYPRCTL_TIMEOUT)
                s.connect(IPC_SOCKET)
                s.sendall(("dispatch " + cmd + "\n").encode())
                while s.recv(65536):
                    pass
            return
    except (OSError, socket.timeout):
        pass
    try:
        subprocess.run(
            [HYPRCTL, "dispatch", cmd],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=HYPRCTL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        pass


def monitor_and_ws():
    monitors = hyprctl_json(["monitors", "-j"])
    if not isinstance(monitors, list):
        return None, None
    mon = next((m for m in monitors if isinstance(m, dict) and m.get("focused")), None)
    if mon is None:
        return None, None
    ws_payload = hyprctl_json(["activeworkspace", "-j"])
    ws = ws_payload.get("id") if isinstance(ws_payload, dict) else None
    return mon, ws


def monitor_for_workspace(ws):
    monitors = hyprctl_json(["monitors", "-j"])
    if not isinstance(monitors, list):
        return None
    for mon in monitors:
        if isinstance(mon, dict) and (mon.get("activeWorkspace") or {}).get("id") == ws:
            return mon
    clients = hyprctl_json(["clients", "-j"])
    if isinstance(clients, list):
        monitor_id = next(
            (
                client.get("monitor")
                for client in clients
                if isinstance(client, dict)
                and (client.get("workspace") or {}).get("id") == ws
            ),
            None,
        )
        return next(
            (
                mon
                for mon in monitors
                if isinstance(mon, dict) and mon.get("id") == monitor_id
            ),
            None,
        )
    return None


def current_rows(mon, ws):
    wins = hyprctl_json(["clients", "-j"])
    rows = []
    if not isinstance(wins, list):
        return rows
    for w in wins:
        if not isinstance(w, dict):
            continue
        addr = normalize_address(w.get("address"))
        if not addr:
            continue
        workspace = w.get("workspace", {}) or {}
        if workspace.get("id") != ws:
            continue
        if not (w.get("mapped") and not w.get("hidden") and not w.get("fullscreen")):
            continue
        row = dict(w)
        row["address"] = addr
        rows.append(row)
    return rows


def focused_address():
    payload = hyprctl_json(["activewindow", "-j"])
    if isinstance(payload, dict):
        return normalize_address(payload.get("address"))
    return None


def cursor_window(mon, ws):
    """Address of the frontmost managed window on `ws` under the cursor.

    Reads `hyprctl cursorpos` (logical coordinates); among windows whose rect
    contains the point, the one with the highest focusHistoryID is the
    frontmost. Returns None when the cursor sits over no managed window.
    """
    try:
        proc = subprocess.run(
            [HYPRCTL, "cursorpos"],
            capture_output=True,
            text=True,
            check=True,
            timeout=HYPRCTL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return None
    try:
        cx, cy = (int(v) for v in proc.stdout.strip().split(","))
    except (ValueError, AttributeError):
        return None
    best, best_hist = None, -1
    for w in current_rows(mon, ws):
        x, y = w["at"]
        ww, hh = w["size"]
        if x <= cx <= x + ww and y <= cy <= y + hh:
            hist = int(w.get("focusHistoryID", -1) or -1)
            if hist > best_hist:
                best_hist = hist
                best = w["address"]
    return best


def geometry(mon):
    scale = mon.get("scale") or 1.0
    log_w = int(mon["width"] / scale)
    log_h = int(mon["height"] / scale)
    rl, rt, rr, rb = (int(x) for x in (mon.get("reserved") or [0, 0, 0, 0]))
    return {
        "l": rl,
        "t": rt,
        "w": log_w - rl - rr,
        "h": log_h - rt - rb,
    }


def cell_list(mon, ws):
    """Cells as (cx_center, cy_center, x, y, w, h), inset by outer gap+border."""
    g = geometry(mon)
    rows = current_rows(mon, ws)
    n = len(rows)
    if n == 0:
        return []
    cols = max(1, math.ceil(math.sqrt(n)))
    rows_n = math.ceil(n / cols)

    pad = GAPS_OUT + BORDER
    rx = g["l"] + pad
    ry = g["t"] + pad
    rw = g["w"] - 2 * pad
    rh = g["h"] - 2 * pad

    # Floating windows draw their border/glow outward past the box edge, which
    # eats into a small gap. Use a generous box gap so a visible background gap
    # remains between tiles (natural Hyprland tiling uses ~14px box separation;
    # floating needs a bit more to compensate for the outward-drawn border).
    inner_gap = 18

    def edges(origin, span, count, gap):
        """Integer left edges + widths, with an exact `gap` between tiles."""
        tw = (span - gap * (count - 1)) / count
        lefts = [round(origin + c * (tw + gap)) for c in range(count)]
        widths = []
        for c in range(count):
            right = lefts[c + 1] if c + 1 < count else origin + span
            widths.append(right - lefts[c] - (gap if c + 1 < count else 0))
        return lefts, widths

    xs, ws = edges(rx, rw, cols, inner_gap)
    ys, hs = edges(ry, rh, rows_n, inner_gap)

    cells = []
    idx = 0
    for r in range(rows_n):
        for c in range(cols):
            if idx >= n:
                break
            x, y = xs[c], ys[r]
            w, h = ws[c], hs[r]
            cx = x + w / 2.0
            cy = y + h / 2.0
            cells.append((cx, cy, x, y, w, h))
            idx += 1
    return cells


def nearest_layout(mon, ws, prio_order=None, force_first_addr=None):
    """Assign each window to a distinct cell, honoring drop position.

    prio_order is a list of addresses (the windows the user just moved).
    Those are assigned to the cell nearest their current position first
    (so a dropped window keeps its drop cell), then the remaining windows
    fill the leftover cells by nearest distance.

    force_first_addr, when given, claims the first (top-left) cell for that
    window before anything else -- used on the initial equalize so the window
    under the cursor anchors the grid while everyone else lays out normally.

    Returns (targets, applied) where targets is a list of
    (address, x, y, w, h) and applied maps address -> cell index.
    """
    cells = cell_list(mon, ws)
    rows = current_rows(mon, ws)
    n = len(rows)
    if n == 0:
        return [], {}

    prio_order = prio_order or []
    index_of = {r["address"]: i for i, r in enumerate(rows)}
    cells_rem = set(range(n))
    assignment = {}

    if force_first_addr is not None and force_first_addr in index_of:
        assignment[index_of[force_first_addr]] = 0
        cells_rem.discard(0)

    def nearest_unused_cell(cx, cy):
        best, bd = None, float("inf")
        for j in cells_rem:
            ccx, ccy = cells[j][0], cells[j][1]
            d = (cx - ccx) ** 2 + (cy - ccy) ** 2
            if d < bd:
                bd = d
                best = j
        return best

    def pick(window_index):
        w = rows[window_index]
        cx = w["at"][0] + w["size"][0] / 2.0
        cy = w["at"][1] + w["size"][1] / 2.0
        j = nearest_unused_cell(cx, cy)
        assignment[window_index] = j
        cells_rem.discard(j)

    # 1) Priority (dragged) windows claim their nearest cell first.
    for addr in prio_order:
        idx = index_of.get(addr)
        if idx is not None and idx not in assignment:
            pick(idx)
    # 2) Remaining windows fill leftover cells by nearest distance (greedy).
    remaining = [i for i in range(n) if i not in assignment]
    centers = [
        (r["at"][0] + r["size"][0] / 2.0, r["at"][1] + r["size"][1] / 2.0)
        for r in rows
    ]
    while remaining:
        best = None
        bd = float("inf")
        for i in remaining:
            wx, wy = centers[i]
            for j in cells_rem:
                cx, cy = cells[j][0], cells[j][1]
                d = (wx - cx) ** 2 + (wy - cy) ** 2
                if d < bd:
                    bd = d
                    best = (i, j)
        i, j = best
        assignment[i] = j
        remaining.remove(i)
        cells_rem.discard(j)

    targets = []
    for i, j in assignment.items():
        _, _, x, y, w, h = cells[j]
        targets.append((rows[i]["address"], x, y, w, h))
    applied = {rows[i]["address"]: j for i, j in assignment.items()}
    return targets, applied


def fill_target_cell(mon, ws, fill_dir):
    """Cell index of the tile that `fill_dir` stretches, or None when not applicable.

    horizontal -> the last cell (bottom-right; stretched rightward to row end).
    vertical   -> the cell directly above the empty bottom-right corner
                  (stretched downward to the work area bottom).
    Both require a partial last row (n % cols != 0) and at least two windows.
    """
    if fill_dir in (None, "off"):
        return None
    cells = cell_list(mon, ws)
    n = len(cells)
    if n < 2 or n % math.ceil(math.sqrt(n)) == 0:
        return None
    cols = max(1, math.ceil(math.sqrt(n)))
    if fill_dir == "horizontal":
        return n - 1
    rows_n = math.ceil(n / cols)
    idx = (rows_n - 2) * cols + (cols - 1)
    return idx if 0 <= idx < n else None


def extend_last_cell(mon, targets, applied, fill_dir):
    if fill_dir in (None, "off") or len(targets) < 2 or not applied:
        return targets
    n = len(targets)
    cols = max(1, math.ceil(math.sqrt(n)))
    if n % cols == 0:
        return targets
    rows_n = math.ceil(n / cols)
    g = geometry(mon)
    pad = GAPS_OUT + BORDER
    rx = g["l"] + pad
    ry = g["t"] + pad
    rw = g["w"] - 2 * pad
    rh = g["h"] - 2 * pad

    if fill_dir == "vertical":
        target_cell = (rows_n - 2) * cols + (cols - 1)
        if not (0 <= target_cell < n):
            return targets
        addr = next((a for a, c in applied.items() if c == target_cell), None)
        if addr is None:
            return targets
        ti = next((i for i, (a2, *_r) in enumerate(targets) if a2 == addr), None)
        if ti is None:
            return targets
        a2, x, y, w, h = targets[ti]
        new_h = int(round((ry + rh) - y))
        if new_h > h:
            targets[ti] = (a2, x, y, w, new_h)
        return targets

    # horizontal (legacy default)
    last_cell = max(applied.values(), default=None)
    if last_cell is None or last_cell // cols != rows_n - 1:
        return targets
    target_idx = None
    for i, (addr, *_rest) in enumerate(targets):
        if applied.get(addr) == last_cell:
            target_idx = i
            break
    if target_idx is None:
        return targets
    row_end = rx + rw
    addr, x, y, w, h = targets[target_idx]
    new_w = int(round(row_end - x))
    if new_w > w:
        targets[target_idx] = (addr, x, y, new_w, h)
    return targets


def apply_fill_in_place(mon, ws, fill_dir, current_rects, cell_map, stretch_state):
    """Adjust only the stretched tile(s) when the fill direction changes.

    `stretch_state` retains (address, direction, pre-stretch rectangle).
    Returns (updated_rects, new_stretch_state).
    """
    cells = cell_list(mon, ws)
    n = len(cells)
    g = geometry(mon)
    pad = GAPS_OUT + BORDER
    row_end = g["l"] + pad + (g["w"] - 2 * pad)
    bottom = g["t"] + pad + (g["h"] - 2 * pad)

    updated = dict(current_rects)
    prev_addr = stretch_state[0] if stretch_state else None
    prev_base = stretch_state[2] if len(stretch_state) > 2 else None

    def natural_cell_for(addr):
        idx = cell_map.get(addr)
        if idx is None or idx >= len(cells):
            return None
        _, _, nx, ny, nw, nh = cells[idx]
        return (nx, ny, nw, nh)

    def restore_tile(addr):
        nat = prev_base if addr == prev_addr and prev_base else natural_cell_for(addr)
        if nat is None:
            return
        nx, ny, nw, nh = nat
        dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {nw}, y = {nh}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {nx}, y = {ny}, relative = false }})')
        updated[addr] = (nx, ny, nw, nh)

    # Restore the previously-stretched tile if it is no longer the target.
    new_target_cell = fill_target_cell(mon, ws, fill_dir)
    new_target_addr = None
    if new_target_cell is not None:
        new_target_addr = next((a for a, c in cell_map.items() if c == new_target_cell), None)

    if prev_addr and (prev_addr != new_target_addr or fill_dir == "off"):
        restore_tile(prev_addr)

    if fill_dir == "off" or new_target_addr is None or new_target_cell is None:
        return updated, (None, None, None)

    # Stretch the new target tile in place.
    _, _, tx, ty, tw, th = cells[new_target_cell]
    ax, ay, aw, ah = updated.get(new_target_addr, (tx, ty, tw, th))
    stretch_base = (ax, ay, aw, ah)
    if fill_dir == "horizontal":
        new_w = int(round(row_end - ax))
        new_rect = (ax, ay, new_w, ah) if new_w > aw else (ax, ay, aw, ah)
    else:  # vertical
        new_h = int(round(bottom - ay))
        new_rect = (ax, ay, aw, new_h) if new_h > ah else (ax, ay, aw, ah)

    if new_rect != updated.get(new_target_addr):
        nx, ny, nw, nh = new_rect
        dispatch(f'hl.dsp.window.resize({{ window = "address:{new_target_addr}", x = {nw}, y = {nh}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{new_target_addr}", x = {nx}, y = {ny}, relative = false }})')
        updated[new_target_addr] = new_rect

    return updated, (new_target_addr, fill_dir, stretch_base)


def remove_stretch(rects, stretch_state):
    base = dict(rects)
    if stretch_state and len(stretch_state) > 2:
        addr, _direction, original = stretch_state
        if addr in base and original is not None:
            base[addr] = original
    return base


def fill_layout(mon, ws, rects, cell_map, fill_dir):
    target_cell = fill_target_cell(mon, ws, fill_dir)
    target_addr = next(
        (addr for addr, cell in cell_map.items() if cell == target_cell), None
    )
    stretch_base = rects.get(target_addr) if target_addr else None
    targets = [(addr, *rect) for addr, rect in rects.items()]
    filled = extend_last_cell(mon, targets, cell_map, fill_dir)
    return (
        {addr: (x, y, width, height) for addr, x, y, width, height in filled},
        (target_addr, fill_dir, stretch_base),
    )


def apply_grid(mon, ws, prio_order=None, fill_dir="off", force_first_addr=None):
    """Float + equalize all managed windows, retaining pre-fill geometry."""
    targets, applied = nearest_layout(mon, ws, prio_order, force_first_addr)
    sizes = {}
    rects = {}
    # Phase 1: float every window first.  Hyprland assigns each window a
    # default floating size on the transition; we need that to settle before
    # issuing the precise resize/move, otherwise the resize can land on the
    # pre-float geometry or be silently dropped.
    for addr, x, y, w, h in targets:
        sizes[addr] = (w, h)
        rects[addr] = (x, y, w, h)
        dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "enable" }})')
    # Give Hyprland a beat to finish transitioning all windows to floating.
    time.sleep(0.05)
    # Phase 2: resize + move every window to its exact cell.
    for addr, x, y, w, h in targets:
        dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {w}, y = {h}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y}, relative = false }})')
    # Phase 3: some apps (e.g. Krita) enforce a minimum size that is larger
    # than the equal cell.  Re-compute the grid so each column/row is at least
    # as large as the largest window assigned to it, so the oversized windows
    # stop overlapping their neighbours.
    time.sleep(0.05)
    applied, sizes, rects = _fit_min_sizes(mon, ws, targets, applied, sizes, rects)
    # Phase 4: fill-stretch the last cell, then dispatch only what changed.
    fitted = [(a, *(rects.get(a, (x, y, w, h)))) for a, x, y, w, h in targets]
    target_cell = fill_target_cell(mon, ws, fill_dir)
    target_addr = next(
        (addr for addr, cell in applied.items() if cell == target_cell), None
    )
    stretch_base = rects.get(target_addr) if target_addr else None
    stretched = extend_last_cell(mon, fitted, applied, fill_dir)
    for addr, x, y, w, h in stretched:
        px, py, pw, ph = rects.get(addr, (x, y, w, h))
        if (px, py, pw, ph) != (x, y, w, h):
            dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {w}, y = {h}, relative = false }})')
            dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y}, relative = false }})')
            rects[addr] = (x, y, w, h)
            sizes[addr] = (w, h)
    return applied, sizes, rects, (target_addr, fill_dir, stretch_base)


def _fit_min_sizes(mon, ws, targets, applied, fallback_sizes, fallback_rects):
    """Iteratively re-layout the grid so columns/rows grow to fit
    min-size-constrained windows.

    Each pass measures how far every window's ACTUAL size (what Hyprland
    refused to shrink it below) exceeds its equal cell and grows those
    columns/rows; flexible columns split the leftover.  Because shrinking one
    column can surface a constraint in its neighbour, passes repeat until no
    window overflows its cell, or a small iteration cap is reached.

    Windows are measured against their target cell (not their current
    position, which is unreliable after Hyprland clamps an oversized window),
    so multiple constrained windows do not cascade position errors.

    Returns (applied, sizes, rects).
    """
    g = geometry(mon)
    n = len(targets)
    if n <= 1:
        return applied, fallback_sizes, fallback_rects

    cols = max(1, math.ceil(math.sqrt(n)))
    rows_n = math.ceil(n / cols)
    G = 18
    pad = GAPS_OUT + BORDER
    rx = g["l"] + pad
    ry = g["t"] + pad
    rw = g["w"] - 2 * pad
    rh = g["h"] - 2 * pad

    base_rects = {a: (x, y, w, h) for a, x, y, w, h in targets}
    cells = {}
    for addr, x, y, w, h in targets:
        cell = applied.get(addr)
        if cell is not None:
            cells[addr] = cell
    if not cells:
        return applied, fallback_sizes, fallback_rects

    def actual_sizes():
        out = {}
        for ww in current_rows(mon, ws):
            out[ww["address"]] = (int(ww["size"][0]), int(ww["size"][1]))
        return out

    def distribute(need, span, gap, count):
        """Return (lefts, widths) that tile `span` exactly.  Slots whose need
        exceeds the equal share keep it; flexible slots split the leftover.
        If the needs alone overflow the span, everything scales down
        proportionally so the layout still fits."""
        total_gaps = gap * (count - 1)
        available = span - total_gaps
        base = available / count
        if sum(need) >= available:
            scale = available / sum(need) if sum(need) > 0 else 0
            widths = [max(1, int(round(nd * scale))) for nd in need]
        else:
            fixed = [i for i in range(count) if need[i] > base]
            fixed_total = sum(need[i] for i in fixed)
            leftover = available - fixed_total
            flex = [i for i in range(count) if i not in fixed]
            each = leftover / len(flex) if flex else 0
            widths = [
                int(round(need[i])) if i in fixed else int(round(each))
                for i in range(count)
            ]
        lefts = [0] * count
        cur = 0
        for i in range(count):
            lefts[i] = cur
            cur += widths[i] + gap
        return lefts, widths

    rects = dict(base_rects)
    sizes = {a: (b[2], b[3]) for a, b in base_rects.items()}
    for _ in range(6):
        actual = actual_sizes()
        col_need = [0.0] * cols
        row_need = [0.0] * rows_n
        any_excess = False
        for addr, cell in cells.items():
            c = cell % cols
            r = cell // cols
            w, h = base_rects[addr][2], base_rects[addr][3]
            aw, ah = actual.get(addr, (w, h))
            if aw > w + 4:
                col_need[c] = max(col_need[c], aw)
                any_excess = True
            if ah > h + 4:
                row_need[r] = max(row_need[r], ah)
                any_excess = True
        if not any_excess:
            break
        col_lefts, col_widths = distribute(col_need, rw, G, cols)
        row_lefts, row_heights = distribute(row_need, rh, G, rows_n)
        next_rects = {}
        for addr, cell in cells.items():
            c = cell % cols
            r = cell // cols
            nx, ny = rx + col_lefts[c], ry + row_lefts[r]
            nw, nh = col_widths[c], row_heights[r]
            next_rects[addr] = (nx, ny, nw, nh)
        sizes = {a: (next_rects[a][2], next_rects[a][3]) for a in cells}
        # Only dispatch windows whose rectangle actually changed, so later
        # passes don't re-trigger a visible shuffle on settled tiles.
        moved = False
        for addr, (nx, ny, nw, nh) in next_rects.items():
            if rects.get(addr) == (nx, ny, nw, nh):
                continue
            dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {nw}, y = {nh}, relative = false }})')
            dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {nx}, y = {ny}, relative = false }})')
            moved = True
        rects = next_rects
        if not moved:
            continue
        time.sleep(0.06)

    return applied, sizes, rects


def _split_delta(amount, before_capacity, after_capacity):
    """Split growth around a tile, spilling to whichever side has room."""
    before = min(amount // 2, before_capacity)
    after = min(amount - before, after_capacity)
    before += min(amount - before - after, before_capacity - before)
    return before, after


def _take_nearest(values, indexes, amount, minimums):
    """Remove pixels from nearest neighbors first and return the amount taken."""
    taken = 0
    for index in indexes:
        available = max(0, values[index] - minimums[index])
        change = min(amount - taken, available)
        values[index] -= change
        taken += change
        if taken == amount:
            break
    return taken


def _give_nearest(values, indexes, amount):
    if not indexes or amount <= 0:
        return 0
    first = amount // len(indexes)
    remainder = amount % len(indexes)
    for position, index in enumerate(indexes):
        values[index] += first + (1 if position < remainder else 0)
    return amount


def resize_slot_layout(
    rects,
    cell_map,
    pinned_addr,
    requested_size,
    minimum=MIN_TILE_SIZE,
    minimums=None,
):
    """Resize one persistent slot while retaining a gap-free rectangular grid.

    Width is local to the pinned slot's row. Height belongs to the complete row
    band, preventing a tall widened tile from overlapping windows above or below.
    Neighboring slots absorb growth from nearest to farthest.
    """
    if pinned_addr not in rects or pinned_addr not in cell_map:
        return dict(rects)

    minimums = minimums or {}
    updated = dict(rects)
    cols = max(1, math.ceil(math.sqrt(len(rects))))
    pin_row = cell_map[pinned_addr] // cols
    row_addrs = sorted(
        (addr for addr in rects if cell_map.get(addr, -1) // cols == pin_row),
        key=lambda addr: rects[addr][0],
    )
    pin_index = row_addrs.index(pinned_addr)
    widths = [rects[addr][2] for addr in row_addrs]
    min_widths = [max(minimum, minimums.get(addr, (0, 0))[0]) for addr in row_addrs]
    old_width = widths[pin_index]
    wanted_width = max(min_widths[pin_index], int(requested_size[0]))
    width_delta = wanted_width - old_width

    left = list(range(pin_index - 1, -1, -1))
    right = list(range(pin_index + 1, len(widths)))
    if width_delta > 0:
        left_capacity = sum(max(0, widths[i] - min_widths[i]) for i in left)
        right_capacity = sum(max(0, widths[i] - min_widths[i]) for i in right)
        grow = min(width_delta, left_capacity + right_capacity)
        take_left, take_right = _split_delta(grow, left_capacity, right_capacity)
        _take_nearest(widths, left, take_left, min_widths)
        _take_nearest(widths, right, take_right, min_widths)
        widths[pin_index] += grow
    elif width_delta < 0:
        release = min(-width_delta, old_width - min_widths[pin_index])
        recipients = ([left[0]] if left else []) + ([right[0]] if right else [])
        if recipients:
            _give_nearest(widths, recipients, release)
            widths[pin_index] -= release

    row_left = min(rects[addr][0] for addr in row_addrs)
    x = row_left
    for addr, width in zip(row_addrs, widths):
        _, y, _, height = updated[addr]
        updated[addr] = (x, y, width, height)
        x += width + GRID_GAP

    row_ids = sorted({cell // cols for cell in cell_map.values()})
    row_members = {
        row: [addr for addr in rects if cell_map.get(addr, -1) // cols == row]
        for row in row_ids
    }
    row_heights = [rects[row_members[row][0]][3] for row in row_ids]
    min_heights = [
        max(
            [minimum]
            + [minimums.get(addr, (0, 0))[1] for addr in row_members[row]]
        )
        for row in row_ids
    ]
    row_index = row_ids.index(pin_row)
    old_height = row_heights[row_index]
    wanted_height = max(min_heights[row_index], int(requested_size[1]))
    height_delta = wanted_height - old_height
    above = list(range(row_index - 1, -1, -1))
    below = list(range(row_index + 1, len(row_heights)))
    if height_delta > 0:
        above_capacity = sum(max(0, row_heights[i] - min_heights[i]) for i in above)
        below_capacity = sum(max(0, row_heights[i] - min_heights[i]) for i in below)
        grow = min(height_delta, above_capacity + below_capacity)
        take_above, take_below = _split_delta(grow, above_capacity, below_capacity)
        _take_nearest(row_heights, above, take_above, min_heights)
        _take_nearest(row_heights, below, take_below, min_heights)
        row_heights[row_index] += grow
    elif height_delta < 0:
        release = min(-height_delta, old_height - min_heights[row_index])
        recipients = ([above[0]] if above else []) + ([below[0]] if below else [])
        if recipients:
            _give_nearest(row_heights, recipients, release)
            row_heights[row_index] -= release

    top = min(rect[1] for rect in rects.values())
    y = top
    for row, height in zip(row_ids, row_heights):
        for addr in row_members[row]:
            x, _, width, _ = updated[addr]
            updated[addr] = (x, y, width, height)
        y += height + GRID_GAP
    return updated


def apply_rects(rects, previous=None, force=None):
    """Apply changed floating rectangles and return their size snapshot."""
    force = set(force or ())
    for addr, (x, y, width, height) in rects.items():
        if addr not in force and previous and previous.get(addr) == (x, y, width, height):
            continue
        dispatch(f'hl.dsp.window.resize({{ window = "address:{addr}", x = {width}, y = {height}, relative = false }})')
        dispatch(f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y}, relative = false }})')
    return {addr: (rect[2], rect[3]) for addr, rect in rects.items()}


def swap_slot_layout(rects, cell_map, moved_addr, center):
    """Move a window into the nearest persistent slot, swapping occupants."""
    if moved_addr not in rects:
        return dict(rects), dict(cell_map)
    cx, cy = center
    candidates = list(rects)
    destination = min(
        candidates,
        key=lambda addr: (
            0 if rects[addr][0] <= cx <= rects[addr][0] + rects[addr][2]
            and rects[addr][1] <= cy <= rects[addr][1] + rects[addr][3] else 1,
            (rects[addr][0] + rects[addr][2] / 2 - cx) ** 2
            + (rects[addr][1] + rects[addr][3] / 2 - cy) ** 2,
        ),
    )
    if destination == moved_addr:
        return dict(rects), dict(cell_map)
    return _swap_slots(rects, cell_map, moved_addr, destination)


def _swap_slots(rects, cell_map, first, second):
    new_rects = dict(rects)
    new_rects[first], new_rects[second] = rects[second], rects[first]
    new_map = dict(cell_map)
    if first in new_map and second in new_map:
        new_map[first], new_map[second] = new_map[second], new_map[first]
    return new_rects, new_map


def swap_directional_layout(rects, cell_map, moved_addr, center):
    """Swap with the next occupied logical slot in the movement direction."""
    if moved_addr not in rects or moved_addr not in cell_map:
        return dict(rects), dict(cell_map)
    source = rects[moved_addr]
    sx = source[0] + source[2] / 2
    sy = source[1] + source[3] / 2
    dx = center[0] - sx
    dy = center[1] - sy
    cols = max(1, math.ceil(math.sqrt(len(rects))))
    source_row, source_col = divmod(cell_map[moved_addr], cols)

    if abs(dx) >= abs(dy):
        direction = "right" if dx > 0 else "left"
    else:
        direction = "down" if dy > 0 else "up"
    return swap_logical_layout(rects, cell_map, moved_addr, direction)


def swap_logical_layout(rects, cell_map, moved_addr, direction):
    """Swap with the adjacent occupied slot in an explicit direction."""
    destination = logical_swap_target(rects, cell_map, moved_addr, direction)
    if destination is None:
        return dict(rects), dict(cell_map)
    return _swap_slots(rects, cell_map, moved_addr, destination)


def logical_swap_target(rects, cell_map, moved_addr, direction):
    """Address in the adjacent occupied slot, or None at a grid edge."""
    if moved_addr not in rects or moved_addr not in cell_map:
        return None
    source = rects[moved_addr]
    sx = source[0] + source[2] / 2
    cols = max(1, math.ceil(math.sqrt(len(rects))))
    source_row, source_col = divmod(cell_map[moved_addr], cols)
    candidates = []
    if direction in ("left", "right"):
        sign = 1 if direction == "right" else -1
        for addr, cell in cell_map.items():
            row, col = divmod(cell, cols)
            if row == source_row and (col - source_col) * sign > 0:
                candidates.append((abs(col - source_col), addr))
    else:
        sign = 1 if direction == "down" else -1
        for addr, cell in cell_map.items():
            row, _ = divmod(cell, cols)
            if (row - source_row) * sign <= 0:
                continue
            rect = rects[addr]
            cx = rect[0] + rect[2] / 2
            candidates.append((abs(row - source_row), abs(cx - sx), addr))

    if not candidates:
        return None
    return min(candidates)[-1]


def fit_slot_constraints(rects, cell_map, constraints):
    """Grow destination slots to observed app minima before a swap is shown."""
    fitted = dict(rects)
    for addr, size in constraints.items():
        if addr not in fitted:
            continue
        width = max(fitted[addr][2], int(size[0]))
        height = max(fitted[addr][3], int(size[1]))
        fitted = resize_slot_layout(
            fitted, cell_map, addr, (width, height), minimums=constraints
        )
    return fitted


def moved_layout(mon, ws, expected):
    """Addresses whose position drifted away from the last applied slot."""
    if not expected:
        return set()
    off = set()
    for w in current_rows(mon, ws):
        addr = w["address"]
        if addr not in expected:
            continue
        exp_x, exp_y, exp_w, exp_h = expected[addr]
        act_x = int(w["at"][0])
        act_y = int(w["at"][1])
        dx = abs(act_x - exp_x)
        dy = abs(act_y - exp_y)
        if max(dx, dy) > MOVE_THRESHOLD:
            off.add(addr)
    return off


def release_ws(ws):
    """De-float every window on a workspace so it returns to normal tiling."""
    wins = hyprctl_json(["clients", "-j"])
    if not isinstance(wins, list):
        return
    for w in wins:
        if not isinstance(w, dict):
            continue
        addr = normalize_address(w.get("address"))
        if not addr:
            continue
        if (
            w.get("workspace", {}).get("id") == ws
            and w.get("mapped")
            and not w.get("hidden")
            and w.get("floating")
        ):
            dispatch(f'hl.dsp.window.float({{ window = "address:{addr}", action = "disable" }})')


def _current_mapped(ws):
    """Managed (mapped, visible, non-fullscreen) windows currently on `ws`."""
    wins = hyprctl_json(["clients", "-j"])
    rows = []
    if not isinstance(wins, list):
        return rows
    for w in wins:
        if not isinstance(w, dict):
            continue
        addr = normalize_address(w.get("address"))
        if not addr:
            continue
        ws_id = (w.get("workspace") or {}).get("id")
        if ws_id != ws:
            continue
        if not (w.get("mapped") and not w.get("hidden") and not w.get("fullscreen")):
            continue
        rows.append(w)
    return rows


def restore_snapshot(ws):
    """Toggle-OFF: release the grid back to Hyprland's native tiling.

    De-floats every window on the workspace in one pass -- no ordering, no
    reconstruction. Dwindle re-tiles the workspace naturally into its own layout.
    (Hyprland exposes no split-tree API, so any attempt to recreate an arbitrary
    pre-grid arrangement exactly is approximate at best; releasing natively is
    fast, predictable, and never leaves windows stranded floating.) Any captured
    snapshot is discarded.
    """
    clear_snapshot(ws)
    release_ws(ws)


def verify_socket_path(path, basename):
    """Only trust a Hyprland socket that is really ours.

    A process on the same machine could plant a socket or a symlink at the
    expected path to feed us crafted events (event socket) or swallow our
    dispatches (command socket). Before reading from or writing to it, require
    that the path resolves, without any symlink, to the exact socket inside our
    own XDG_RUNTIME_DIR, that it is a socket, and that we own it.
    """
    try:
        st = os.stat(path)
    except OSError:
        return False
    if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid():
        return False
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not sig or not re.fullmatch(r"[A-Za-z0-9_]+", sig):
        return False
    runtime = os.path.realpath(
        os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    )
    expected_dir = os.path.join(runtime, "hypr", sig)
    try:
        dst = os.stat(expected_dir)
    except OSError:
        return False
    if not stat.S_ISDIR(dst.st_mode) or dst.st_uid != os.getuid():
        return False
    return os.path.realpath(path) == os.path.join(expected_dir, basename)


def run_daemon():
    if not verify_socket_path(SOCKET, ".socket2.sock"):
        if os.environ.get("EQUALIZE_DEBUG"):
            print(f"DBG refusing to read untrusted socket {SOCKET!r}", file=sys.stderr, flush=True)
        return
    if not os.environ.get("EQUALIZE_PRESERVE_STATE"):
        reset_state()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(SOCKET)
    except OSError:
        sock.close()
        return
    move_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    move_socket_inode = None
    try:
        runtime_info = os.stat(RUNTIME_DIR)
        if (
            os.path.realpath(RUNTIME_DIR) != os.path.abspath(RUNTIME_DIR)
            or not stat.S_ISDIR(runtime_info.st_mode)
            or runtime_info.st_uid != os.getuid()
            or runtime_info.st_mode & 0o022
        ):
            raise OSError("refusing unsafe runtime directory")
        try:
            existing = os.lstat(MOVE_SOCKET)
        except FileNotFoundError:
            existing = None
        if existing is not None:
            if not stat.S_ISSOCK(existing.st_mode) or existing.st_uid != os.getuid():
                raise OSError("refusing unsafe move socket path")
            os.unlink(MOVE_SOCKET)
        move_sock.bind(MOVE_SOCKET)
        os.chmod(MOVE_SOCKET, 0o600)
        move_socket_inode = os.lstat(MOVE_SOCKET).st_ino
    except OSError:
        move_sock.close()
        move_sock = None

    release_on_start = os.environ.get("EQUALIZE_RELEASE_WORKSPACE")
    if release_on_start and release_on_start.lstrip("-").isdigit():
        release_ws(int(release_on_start))

    now = time.monotonic()
    fill_dir = get_config_choice("fill_remainder")
    last_fill = fill_dir        # fill direction value we last acted on
    stretch_state = (None, None, None)  # (address, direction, pre-stretch rect)
    last_apply = 0.0         # monotonic time we last applied a layout
    pending_apply = []       # [(due_time, ws), ...] queued event re-applies
    fill_suppress_until = 0.0  # ignore our own fill-change events before this time
    off_state = (None, None)  # (off_seen frozenset, time first seen)
    current_map = {}         # address -> cell index of the layout we last applied
    current_rects = {}       # address -> (x, y, w, h) we last applied
    last_sizes = {}          # address -> (w, h) we last applied
    minimum_sizes = {}       # address -> app minimum dimensions observed on refusal
    grids = set()            # workspace ids currently gridded/preserved
    grid_members = {}        # workspace id -> set of addresses its grid covers
    workspace_states = {}    # workspace id -> persistent custom layout state
    active_state_ws = None
    pending_events = deque() # socket events awaiting processing (bounded per tick)

    def snap_sizes(mon, ws):
        return {
            w["address"]: (int(w["size"][0]), int(w["size"][1]))
            for w in current_rows(mon, ws)
        }

    def save_active_state():
        if active_state_ws is None:
            return
        workspace_states[active_state_ws] = {
            "map": dict(current_map),
            "rects": dict(current_rects),
            "sizes": dict(last_sizes),
            "minimums": dict(minimum_sizes),
            "stretch": stretch_state,
            "off": off_state,
        }

    def activate_state(ws):
        nonlocal active_state_ws, current_map, current_rects, last_sizes
        nonlocal minimum_sizes, stretch_state, off_state
        if ws == active_state_ws:
            return
        save_active_state()
        active_state_ws = ws
        state = workspace_states.get(ws, {})
        current_map = dict(state.get("map", {}))
        current_rects = dict(state.get("rects", {}))
        last_sizes = dict(state.get("sizes", {}))
        minimum_sizes = dict(state.get("minimums", {}))
        stretch_state = state.get("stretch", (None, None, None))
        off_state = state.get("off", (None, None))

    def reapply(mon, ws, prio=None, force_first=None):
        """Apply the equal grid and refresh tracking. Returns the cell map."""
        nonlocal current_map, last_sizes, current_rects, stretch_state, grid_members
        m, s, rects, applied_stretch = apply_grid(
            mon, ws, prio, fill_dir, force_first
        )
        current_map = m
        last_sizes = s
        current_rects = rects
        grid_members[ws] = set(m)
        # The fresh grid already incorporates any stretch via extend_last_cell.
        stretch_state = applied_stretch
        save_active_state()
        return m

    def reapply_workspace(mon, ws, prio=None, force_first=None):
        previous_ws = active_state_ws
        activate_state(ws)
        result = reapply(mon, ws, prio, force_first)
        save_active_state()
        if previous_ws != ws:
            activate_state(previous_ws)
        return result

    def grid_if_needed(ws):
        """Grid `ws` if it is marked equalized and not yet gridded. Returns mon."""
        nonlocal current_map, last_sizes, last_apply, current_rects
        mon, cur = monitor_and_ws()
        if mon is None:
            return None
        activate_state(ws)
        wanted = load_wanted()
        rows = current_rows(mon, ws) if ws in wanted else []
        needs_repair = any(not window.get("floating") for window in rows)
        if ws in wanted and (ws not in grids or needs_repair):
            # The window under the cursor anchors the grid's top-left cell on
            # the initial equalize; the rest settle into nearest cells as normal.
            # Re-grids after drag/resize events deliberately do NOT use this.
            current_map = reapply(mon, ws, force_first=cursor_window(mon, ws))
            grids.add(ws)
            last_apply = now
        return mon

    def probe_minimums(mon, ws, rects):
        nonlocal minimum_sizes
        for addr, (_x, _y, width, height) in rects.items():
            dispatch(
                f'hl.dsp.window.resize({{ window = "address:{addr}", x = {width}, y = {height}, relative = false }})'
            )
        time.sleep(0.05)
        measured = snap_sizes(mon, ws)
        for addr, (_x, _y, requested_width, requested_height) in rects.items():
            if addr not in measured:
                continue
            actual_width, actual_height = measured[addr]
            old_minimum = minimum_sizes.get(addr, (0, 0))
            observed = (
                max(
                    old_minimum[0],
                    actual_width if actual_width > requested_width + 4 else 0,
                ),
                max(
                    old_minimum[1],
                    actual_height if actual_height > requested_height + 4 else 0,
                ),
            )
            if observed != (0, 0):
                minimum_sizes[addr] = observed

    def snap_to_slot(mon, ws, moved_addr, directional=False):
        """Snap one moved window into its nearest slot and preserve slot sizing."""
        nonlocal current_map, current_rects, last_sizes, stretch_state
        moved = next(
            (w for w in current_rows(mon, ws) if w["address"] == moved_addr),
            None,
        )
        if moved is None or not current_map:
            return False
        cx = moved["at"][0] + moved["size"][0] / 2
        cy = moved["at"][1] + moved["size"][1] / 2
        swap_layout = swap_directional_layout if directional else swap_slot_layout
        base_rects = remove_stretch(current_rects, stretch_state)
        rects, cell_map = swap_layout(base_rects, current_map, moved_addr, (cx, cy))
        rects, stretch_state = fill_layout(mon, ws, rects, cell_map, fill_dir)
        probe_minimums(mon, ws, rects)
        base_rects = remove_stretch(rects, stretch_state)
        rects = fit_slot_constraints(base_rects, cell_map, minimum_sizes)
        rects, stretch_state = fill_layout(mon, ws, rects, cell_map, fill_dir)
        last_sizes = apply_rects(rects, current_rects, (moved_addr,))
        current_rects = rects
        current_map = cell_map
        return True

    def apply_directional_move(mon, ws, moved_addr, direction):
        """Preflight destination sizes, then apply an adjusted swap immediately."""
        nonlocal current_map, current_rects, last_sizes, minimum_sizes, stretch_state
        base_rects = remove_stretch(current_rects, stretch_state)
        destination = logical_swap_target(
            base_rects, current_map, moved_addr, direction
        )
        if destination is None:
            return False
        rects, cell_map = _swap_slots(
            base_rects, current_map, moved_addr, destination
        )
        rects, next_stretch = fill_layout(mon, ws, rects, cell_map, fill_dir)
        participants = (moved_addr, destination)
        probe_minimums(mon, ws, rects)
        base_rects = remove_stretch(rects, next_stretch)
        rects = fit_slot_constraints(base_rects, cell_map, minimum_sizes)
        rects, stretch_state = fill_layout(mon, ws, rects, cell_map, fill_dir)
        last_sizes = apply_rects(rects, current_rects, participants)
        current_rects = rects
        current_map = cell_map
        return True

    try:
        while True:
            if not os.path.exists(SCRIPT_PATH):
                break
            fill_dir = get_config_choice("fill_remainder")
            now = time.monotonic()
            wanted = load_wanted()

            # If the stretch direction changed while a grid is active, adjust the
            # affected tile(s) in place instead of re-laying-out the whole grid.
            if fill_dir != last_fill:
                previous_ws = active_state_ws
                for wid in list(grids):
                    try:
                        mon_f = monitor_for_workspace(wid)
                        if mon_f is None:
                            continue
                        activate_state(wid)
                        if not current_rects:
                            continue
                        if os.environ.get("EQUALIZE_DEBUG"):
                            print(f"DBG fill change {last_fill}->{fill_dir} ws={wid} rects={len(current_rects)} cmap={len(current_map)} prev={stretch_state}", file=sys.stderr, flush=True)
                        new_rects, stretch_state = apply_fill_in_place(
                            mon_f, wid, fill_dir, current_rects, current_map, stretch_state
                        )
                        current_rects = new_rects
                        # Refresh sizes snapshot so the resize detector does not
                        # mistake our own stretch for a user resize and re-fit the
                        # whole grid on top of it.
                        last_sizes = {a: (r[2], r[3]) for a, r in new_rects.items()}
                        off_state = (None, None)
                        save_active_state()
                    except Exception:
                        traceback.print_exc()
                activate_state(previous_ws)
                last_apply = now
                fill_suppress_until = now + GRACE
                last_fill = fill_dir

            # Release grids that are no longer marked equalized (toggle OFF).
            for wid in list(grids):
                if wid not in wanted:
                    # De-float every window (plain release) so the layout engine
                    # re-tiles the workspace; consumes any captured snapshot.
                    restore_snapshot(wid)
                    grids.discard(wid)
                    grid_members.pop(wid, None)
                    if active_state_ws == wid:
                        activate_state(None)
                    workspace_states.pop(wid, None)

            mon, cur = monitor_and_ws()
            if mon is not None:
                activate_state(cur)
                # Grid the active workspace if it is currently marked equalized.
                grid_if_needed(cur)

            # 1) Process any event-triggered (debounced) re-grids for the
            #    affected workspace(s).
            if pending_apply:
                due = min(d for d, _w in pending_apply)
                if now >= due:
                    remaining_apply = []
                    for _due, wid in pending_apply:
                        if _due > now:
                            remaining_apply.append((_due, wid))
                            continue
                        if wid in grids:
                            target_mon = monitor_for_workspace(wid)
                            if target_mon is not None:
                                reapply_workspace(target_mon, wid)
                                last_apply = now
                            else:
                                remaining_apply.append(
                                    (now + EVENT_DEBOUNCE, wid)
                                )
                    pending_apply = remaining_apply

            # 2) Drag-drop / resize detection on the active gridded workspace.
            if mon is not None and cur in grids and now - last_apply > GRACE:
                try:
                    sizes_now = snap_sizes(mon, cur)
                    foc = focused_address()
                    size_changed = False
                    if foc and foc in sizes_now and foc in last_sizes:
                        w0, h0 = last_sizes[foc]
                        w1, h1 = sizes_now[foc]
                        size_changed = abs(w1 - w0) + abs(h1 - h0) >= 6

                    # A keyboard swap moves two windows. A keyboard resize can
                    # move one edge as well as changing size, so a single moved
                    # focused window with a size delta remains a resize.
                    moved = moved_layout(mon, cur, current_rects)
                    if moved:
                        if (
                            len(moved) == 2
                            and foc in moved
                            and snap_to_slot(mon, cur, foc, directional=True)
                        ):
                            last_apply = now
                            off_state = (None, None)
                            continue
                        if not (len(moved) == 1 and foc in moved and size_changed):
                            seen, since = off_state
                            if seen == moved:
                                if now - since >= STABLE:
                                    moved_addr = next(iter(moved)) if len(moved) == 1 else None
                                    if not snap_to_slot(mon, cur, moved_addr):
                                        current_map = reapply(mon, cur, list(moved))
                                    last_apply = now
                                    off_state = (None, None)
                            else:
                                off_state = (moved, now)
                            continue
                    else:
                        off_state = (None, None)

                    # 2b) Resize the focused slot. Width stays local to its row;
                    #     height rebalances complete row bands to avoid overlap.
                    if (
                        foc
                        and foc in sizes_now
                        and foc in last_sizes
                        and foc in current_rects
                        and foc in current_map
                    ):
                        if size_changed:
                            base_rects = remove_stretch(current_rects, stretch_state)
                            expected = current_rects[foc]
                            base = base_rects[foc]
                            requested = (
                                base[2] + (w1 - expected[2]),
                                base[3] + (h1 - expected[3]),
                            )
                            rects = resize_slot_layout(
                                base_rects, current_map, foc, requested,
                                minimums=minimum_sizes,
                            )
                            probe_minimums(mon, cur, rects)
                            rects = fit_slot_constraints(
                                rects, current_map, minimum_sizes
                            )
                            rects, stretch_state = fill_layout(
                                mon, cur, rects, current_map, fill_dir
                            )
                            last_sizes = apply_rects(rects, current_rects, (foc,))
                            current_rects = rects
                            grid_members[cur] = set(current_rects)
                            last_apply = now
                            off_state = (None, None)
                            continue
                except Exception:
                    traceback.print_exc()

            # 3) Read available socket events into the pending queue. Each
            # recv is capped (16 KiB) and only ever appended to the queue.
            readers = [sock] + ([move_sock] if move_sock is not None else [])
            r, _, _ = select.select(readers, [], [], POLL)
            if move_sock is not None and move_sock in r:
                try:
                    request = json.loads(move_sock.recv(512).decode("ascii"))
                except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                    request = {}
                direction = request.get("direction") if isinstance(request, dict) else None
                request_ws = request.get("workspace") if isinstance(request, dict) else None
                request_addr = normalize_address(
                    request.get("address") if isinstance(request, dict) else None
                )
                sent = request.get("sent") if isinstance(request, dict) else None
                request_age = (
                    time.monotonic() - sent
                    if isinstance(sent, (int, float))
                    else float("inf")
                )
                move_mon, move_ws = monitor_and_ws()
                if move_mon is not None:
                    activate_state(move_ws)
                foc = focused_address()
                if (
                    direction in ("left", "right", "up", "down")
                    and request_ws == move_ws
                    and move_ws in grids
                    and request_addr == foc
                    and 0 <= request_age <= 1.0
                ):
                    if apply_directional_move(
                        move_mon, move_ws, request_addr, direction
                    ):
                        last_apply = time.monotonic()
                        off_state = (None, None)
            if sock in r:
                try:
                    data = sock.recv(16384).decode("utf-8", "ignore")
                except OSError:
                    break
                if not data:
                    break
                pending_events.extend(data.splitlines())

            # 4) Drain at most MAX_EVENT_LINES_PER_TICK queued events this
            # tick so a burst/flood of socket events can never make a single
            # loop iteration perform unbounded work; any backlog simply
            # carries over to the next tick.
            processed_events = 0
            while pending_events and processed_events < MAX_EVENT_LINES_PER_TICK:
                line = pending_events.popleft()
                processed_events += 1
                mon, cur = monitor_and_ws()
                if mon is None:
                    continue
                activate_state(cur)
                # If the active workspace changed to a newly equalized one that
                # isn't gridded yet, grid it. Desktops already gridded stay
                # preserved (we never released them on switch-away).
                grid_if_needed(cur)
                # Ignore move/float events we just generated ourselves by
                # stretching a tile in place (see apply_fill_in_place).
                suppressed = time.monotonic() < fill_suppress_until
                # Ignore move/float events from the apply we just ran; the
                # debounced re-apply they would schedule is what makes the
                # toggle look like a double refresh.
                self_applied = now - last_apply < GRACE
                if line.startswith("movewindowv2>>"):
                    # SUPER+SHIFT+<num> shipped a window to another workspace.
                    # The event only carries the target id, so the source grid
                    # is located from per-workspace grid membership instead of
                    # the currently active workspace. Handled outside the
                    # `cur in grids` gate because the events can be drained
                    # after the user has already switched desktops, and a
                    # native (un-gridded) target still needs the source to
                    # re-balance.
                    raw = line[len("movewindowv2>>"):].split(",")
                    moved = normalize_address(raw[0]) if raw else None
                    try:
                        target_ws = int(raw[1]) if len(raw) > 1 else None
                    except (IndexError, ValueError):
                        target_ws = None
                    if moved and target_ws is not None:
                        if target_ws not in wanted:
                            # Native desktop (e.g. a brand-new empty one):
                            # release the window so Hyprland re-tiles it to that
                            # desktop's layout instead of it keeping the
                            # equalized rect it had on the source desktop.
                            dispatch(f'hl.dsp.window.float({{ window = "address:{moved}", action = "disable" }})')
                        if target_ws in grids:
                            # Fold the window into an already-gridded equalized
                            # target desktop's layout.
                            schedule = (now + EVENT_DEBOUNCE, target_ws)
                            if schedule not in pending_apply:
                                pending_apply.append(schedule)
                        # Re-balance the source desktop now that the window left.
                        source_ws = next(
                            (
                                wid
                                for wid, members in grid_members.items()
                                if wid != target_ws and moved in members
                            ),
                            None,
                        )
                        if source_ws is not None:
                            schedule = (now + EVENT_DEBOUNCE, source_ws)
                            if schedule not in pending_apply:
                                pending_apply.append(schedule)
                elif line.startswith("openwindow>>") and not suppressed:
                    addr = normalize_address(
                        line[len("openwindow>>"):].split(",", 1)[0]
                    )
                    opened = next(
                        (
                            window
                            for window in hyprctl_json(["clients", "-j"])
                            if isinstance(window, dict)
                            and normalize_address(window.get("address")) == addr
                        ),
                        None,
                    )
                    opened_ws = (
                        (opened.get("workspace") or {}).get("id")
                        if opened is not None
                        else None
                    )
                    if opened_ws in grids:
                        pending_apply.append((now + EVENT_DEBOUNCE, opened_ws))
                elif line.startswith("closewindow>>") and not suppressed:
                    addr = normalize_address(line[len("closewindow>>"):].split(",", 1)[0])
                    closed_ws = next(
                        (
                            wid
                            for wid, members in grid_members.items()
                            if addr in members
                        ),
                        None,
                    )
                    if closed_ws in grids:
                        pending_apply.append((now + EVENT_DEBOUNCE, closed_ws))
                elif cur in grids:
                    if line.startswith("movewindow>>") and not suppressed and not self_applied:
                        # Position changes are handled by polling and explicit
                        # move requests. Workspace transfers use movewindowv2.
                        pass
                    elif line.startswith("changefloatingmode>>") and not suppressed and not self_applied:
                        pending_apply.append((now + EVENT_DEBOUNCE, cur))
    finally:
        try:
            sock.close()
        except OSError:
            pass
        if move_sock is not None:
            try:
                move_sock.close()
            except OSError:
                pass
            try:
                current = os.lstat(MOVE_SOCKET)
                if stat.S_ISSOCK(current.st_mode) and current.st_ino == move_socket_inode:
                    os.unlink(MOVE_SOCKET)
            except OSError:
                pass


def parse_args():
    parser = argparse.ArgumentParser(description="HyprTile equalizer watcher")
    parser.add_argument(
        "--stop",
        action="store_true",
        help="terminate the currently running watcher instance",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    if args.stop:
        stopped = stop_existing()
        # Nothing to stop is not an error; a verified process that exceeded
        # the stop deadline is.
        return 1 if stopped is False else 0

    global LOCK_FD
    try:
        LOCK_FD = acquire_watcher_lock()
    except BlockingIOError:
        return 0

    def cleanup():
        global LOCK_FD
        remove_pid_record()
        if LOCK_FD is not None:
            try:
                os.close(LOCK_FD)
            except OSError:
                pass
            LOCK_FD = None

    atexit.register(cleanup)

    def _handle_exit(signum, _frame):
        cleanup()
        sys.exit(0)

    try:
        signal.signal(signal.SIGTERM, _handle_exit)
        signal.signal(signal.SIGINT, _handle_exit)
    except Exception:
        pass

    write_pid_record(os.getpid(), SCRIPT_PATH)
    try:
        run_daemon()
    finally:
        cleanup()
    return 0


if __name__ == "__main__":
    sys.exit(main())
