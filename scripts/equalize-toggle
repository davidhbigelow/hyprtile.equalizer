#!/usr/bin/python3
"""Toggle equalize mode for the active workspace and print the new state."""

import json
import os
import subprocess
import sys

from _equalize_state import (
    proc_start_time,
    read_pid_record,
    toggle_workspace_id,
)

HYPRCTL_TIMEOUT = float(os.environ.get("EQUALIZE_HYPRCTL_TIMEOUT", "1.5"))
HYPRCTL_OUTPUT_LIMIT = 64 * 1024
PYTHON = "/usr/bin/python3"
HYPRCTL = "/usr/bin/hyprctl"
SYSTEMD_RUN = "/usr/bin/systemd-run"
WATCHER_UNIT = "hyprtile-equalize.service"


SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
HYPR_SOCKET = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"),
    "hypr",
    os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
    ".socket2.sock",
)


def active_workspace_id():
    try:
        proc = subprocess.run(
            [HYPRCTL, "activeworkspace", "-j"],
            capture_output=True,
            text=True,
            check=True,
            timeout=HYPRCTL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return None
    if len(proc.stdout) > HYPRCTL_OUTPUT_LIMIT:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    wid = payload.get("id")
    return wid if isinstance(wid, int) else None


def watcher_is_running() -> bool:
    record = read_pid_record()
    if not record:
        return False
    pid = record.get("pid")
    script = record.get("script")
    expected_start = record.get("start")
    if not isinstance(pid, int) or not isinstance(script, str):
        return False
    cmdline_path = f"/proc/{pid}/cmdline"
    try:
        with open(cmdline_path, "rb") as handle:
            data = handle.read(64 * 1024)
    except OSError:
        return False
    target = os.path.realpath(script)
    matched = False
    for entry in data.split(b"\0"):
        if not entry:
            continue
        try:
            if os.path.realpath(entry.decode()) == target:
                matched = True
                break
        except (UnicodeDecodeError, OSError):
            continue
    if not matched:
        return False
    if expected_start is not None and proc_start_time(pid) != expected_start:
        return False
    return True


def ensure_watcher_running() -> None:
    if not os.path.exists(HYPR_SOCKET):
        return
    if watcher_is_running():
        return
    watcher = os.path.join(SCRIPT_DIR, "equalize-watch")
    if not os.path.exists(watcher):
        return
    env = {
        "HOME": os.path.expanduser("~"),
        "PATH": "/usr/bin",
        "XDG_RUNTIME_DIR": os.environ.get(
            "XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"
        ),
    }
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if signature:
        env["HYPRLAND_INSTANCE_SIGNATURE"] = signature
    try:
        subprocess.run(
            [
                SYSTEMD_RUN,
                "--user",
                f"--unit={WATCHER_UNIT}",
                "--collect",
                "--property=Type=exec",
                "--property=TimeoutStopSec=5s",
                "--setenv=HYPRLAND_INSTANCE_SIGNATURE",
                "--setenv=XDG_RUNTIME_DIR",
                "--setenv=PATH=/usr/bin",
                PYTHON,
                watcher,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=HYPRCTL_TIMEOUT,
            env=env,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def main() -> int:
    wid = active_workspace_id()
    if wid is None:
        print("0")
        return 0
    enabled = toggle_workspace_id(wid)
    ensure_watcher_running()
    print("1" if enabled else "0")
    return 0


if __name__ == "__main__":
    sys.exit(main())
