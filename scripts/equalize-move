#!/usr/bin/python3
"""Move the focused window by logical grid slot while equalize is active."""

import argparse
import json
import os
import re
import socket
import stat
import subprocess
import time

from _equalize_state import load_workspace_ids

HYPRCTL = "/usr/bin/hyprctl"
DIRECTIONS = {direction: direction for direction in ("left", "right", "up", "down")}
HYPRCTL_MAX_OUTPUT = 64 * 1024
ADDRESS_RE = re.compile(r"^0x[0-9a-fA-F]+$")
SIGNATURE_RE = re.compile(r"^[A-Za-z0-9_]+$")


def hyprctl_json(name):
    try:
        result = subprocess.run(
            [HYPRCTL, name, "-j"],
            capture_output=True,
            text=True,
            check=True,
            timeout=1.5,
        )
        if len(result.stdout) > HYPRCTL_MAX_OUTPUT:
            return None
        return json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return None


def dispatch(command):
    try:
        subprocess.run(
            [HYPRCTL, "dispatch", command],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=1.5,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def move_socket_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not SIGNATURE_RE.fullmatch(signature):
        return ""
    return os.path.join(runtime, f"hyprtile-equalize-move-{signature}.sock")


def request_move(workspace_id, address, direction):
    path = move_socket_path()
    if (
        not path
        or not isinstance(workspace_id, int)
        or not isinstance(address, str)
        or not ADDRESS_RE.fullmatch(address)
        or direction not in DIRECTIONS
    ):
        return False
    try:
        runtime = os.path.dirname(path)
        runtime_info = os.stat(runtime)
        if (
            os.path.realpath(runtime) != os.path.abspath(runtime)
            or not stat.S_ISDIR(runtime_info.st_mode)
            or runtime_info.st_uid != os.getuid()
            or runtime_info.st_mode & 0o022
        ):
            return False
        info = os.lstat(path)
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            return False
        payload = json.dumps(
            {
                "workspace": workspace_id,
                "address": address,
                "direction": direction,
                "sent": time.monotonic(),
            },
            separators=(",", ":"),
        ).encode("ascii")
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as move_socket:
            move_socket.sendto(payload, path)
        return True
    except OSError:
        return False


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("direction", choices=DIRECTIONS)
    args = parser.parse_args()
    workspace = hyprctl_json("activeworkspace")
    workspace_id = workspace.get("id") if isinstance(workspace, dict) else None
    if workspace_id not in load_workspace_ids():
        dispatch(f'hl.dsp.window.swap({{ direction = "{DIRECTIONS[args.direction]}" }})')
        return 0
    active = hyprctl_json("activewindow")
    address = active.get("address") if isinstance(active, dict) else None
    if not isinstance(address, str):
        return 1
    return 0 if request_move(workspace_id, address, args.direction) else 1


if __name__ == "__main__":
    raise SystemExit(main())
